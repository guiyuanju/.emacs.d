;;; iuiw-sleep-test.el --- Sleep integration tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'iuiw-sleep)
(require 'iuiw-remote)

(defvar overlook-remote-mode)

(ert-deftest iuiw-sleep-independent-owners ()
  (let ((iuiw-sleep-mode nil) (iuiw-sleep--token nil)
        (iuiw-remote--sleep-token nil) (overlook-remote-mode t)
        (system-type 'darwin) released)
    (cl-letf (((symbol-function 'system-sleep-block-sleep)
               (lambda (why _) why))
              ((symbol-function 'system-sleep-unblock-sleep)
               (lambda (token) (push token released)))
              ((symbol-function 'iuiw-sleep-refresh) #'ignore))
      (iuiw-sleep-mode 1)
      (iuiw-remote-sync-awake)
      (iuiw-sleep-mode -1)
      (should (equal released '("Emacs manual")))
      (should (equal iuiw-remote--sleep-token "Overlook Remote"))
      (iuiw-remote-stop-awake)
      (should (equal released '("Overlook Remote" "Emacs manual"))))))

(ert-deftest iuiw-sleep-emacs-only-status ()
  (let ((system-type 'darwin)
        (system-sleep--sleep-block-tokens nil))
    (cl-letf (((symbol-function 'process-live-p) #'ignore))
      (should (string-suffix-p " off" (iuiw-sleep-mode-line)))
      (setq system-sleep--sleep-block-tokens
            '((:why "agent-shell (agent busy)") (:why "Overlook Remote")))
      (should (string-suffix-p " on" (iuiw-sleep-mode-line)))
      (should (equal (get-text-property 0 'help-echo (iuiw-sleep-mode-line))
                     "Emacs awake: Agent, Remote")))))
