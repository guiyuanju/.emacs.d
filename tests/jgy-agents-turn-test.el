(ert-deftest jgy-agents-turn-second-hunk-navigation ()
  (jgy-agents-turn-test--repo
    (let* ((path (expand-file-name "code" dir))
           (lines (cl-loop for i from 1 to 100 collect (format "line %d\n" i))))
      (jgy-agents-turn-test--write dir "code" (apply #'concat lines))
      (jgy-agents-turn-begin dir)
      (setf (nth 11 lines) "first edit\n")
      (jgy-agents-turn-test--write dir "code" (apply #'concat lines))
      (jgy-agents-turn-request (list path) (list (cons path 12)))
      (jgy-agents-turn-test--drain)
      (setf (nth 89 lines) "second edit\n")
      (jgy-agents-turn-test--write dir "code" (apply #'concat lines))
      (jgy-agents-turn-request (list path) (list (cons path 90)))
      (jgy-agents-turn-test--drain)
      (let ((entry (car jgy-agents-turn--files)))
        (with-temp-buffer
          (insert (alist-get 'diff entry))
          (goto-char (jgy-agents-follow--hunk (alist-get 'line entry)))
          (should (looking-at "@@ -87,7 [+]87,7 @@")))))))

(ert-deftest jgy-agents-turn-cancel-cleans-pending-patch-files ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-begin dir)
    (jgy-agents-turn-test--write dir "new" "text\n")
    (let ((path (expand-file-name "new" dir)))
      (jgy-agents-turn-request (list path) (list (cons path 1))))
    ;; Pause just before diff starts to exercise iterator unwind cleanup.
    (let ((spawn (symbol-function 'make-process)) temporary)
      (cl-letf (((symbol-function 'make-process)
                 (lambda (&rest args)
                   (if (equal "diff" (car (plist-get args :command)))
                       (progn
                         (setq temporary (copy-sequence jgy-agents-turn--temporary))
                         (apply spawn (plist-put args :command '("sleep" "2"))))
                     (apply spawn args)))))
        (let ((deadline (+ (float-time) 5)))
          (while (and (not temporary) (< (float-time) deadline))
            (accept-process-output nil 0.01)))
        (should (= 2 (length temporary)))
        (jgy-agents-turn-cancel)
        (dolist (path temporary) (should-not (file-exists-p path)))))))
