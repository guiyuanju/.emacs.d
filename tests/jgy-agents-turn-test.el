;;; jgy-agents-turn-test.el --- Turn diff regression checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'jgy-agents-follow)

(ert-deftest jgy-agents-turn-uses-captured-patch ()
  (let ((agent (generate-new-buffer " *turn-diff-test*"))
        (patch "--- a/code.el\n+++ b/code.el\n@@ -1 +1 @@\n-old\n+new\n"))
    (unwind-protect
        (cl-letf (((symbol-function 'jgy-agents-follow--insert)
                   (lambda (_) (insert "unrelated old working-tree change")))
                  ((symbol-function 'display-buffer) (lambda (&rest _) nil)))
          (jgy-agents-follow--show agent `((file . "/tmp/code.el") (diff . ,patch)))
          (with-current-buffer (jgy-agents-follow--buffer-name agent)
            (should (equal (buffer-string) patch))))
      (when-let* ((diff (get-buffer (jgy-agents-follow--buffer-name agent)))) (kill-buffer diff))
      (kill-buffer agent))))

(require 'jgy-agents-turn)

(defun jgy-agents-turn-test--git (dir &rest args)
  (apply #'jgy-agents-turn--git dir "-c" "user.name=Test" "-c"
         "user.email=test@example.invalid" "-c" "commit.gpgsign=false" args))

(defun jgy-agents-turn-test--write (dir name text)
  (with-temp-file (expand-file-name name dir) (insert text)))

(defmacro jgy-agents-turn-test--repo (&rest body)
  (declare (indent 0))
  `(let ((dir (make-temp-file "turn-repo-" t)))
     (unwind-protect
         (with-temp-buffer
           (jgy-agents-turn-test--git dir "init" "-q")
           ,@body)
       (delete-directory dir t))))

(defun jgy-agents-turn-test--drain ()
  "Wait for real subprocesses and timers, with a bounded deadline."
  (let ((deadline (+ (float-time) 10)))
    (while (and (< (float-time) deadline)
                (or jgy-agents-turn--timer jgy-agents-turn--iterator jgy-agents-turn--pending))
      (accept-process-output nil 0.01))
    (should-not jgy-agents-turn--iterator)
    (should-not jgy-agents-turn--pending)
    (should-not jgy-agents-turn--timer)))

(defun jgy-agents-turn-test--scan ()
  (let ((before (copy-tree jgy-agents-turn--files)))
    (jgy-agents-turn-request)
    (jgy-agents-turn-test--drain)
    (not (equal before jgy-agents-turn--files))))

(ert-deftest jgy-agents-turn-dirty-baseline-survives-commit ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-test--write dir "project.md" "base\n")
    (jgy-agents-turn-test--write dir "clean.el" "old\n")
    (jgy-agents-turn-test--git dir "add" ".")
    (jgy-agents-turn-test--git dir "commit" "-qm" "initial")
    (jgy-agents-turn-test--write dir "project.md" "base\nuser todo\n")
    ;; Staged dirt is part of the starting working-tree content too.
    (jgy-agents-turn-test--git dir "add" "project.md")
    (jgy-agents-turn-begin dir)
    (should (= 1 (hash-table-count (plist-get (car jgy-agents-turn--repos) :base))))
    (should-not (jgy-agents-turn-test--scan))
    (jgy-agents-turn-test--write dir "project.md" "base\nuser todo\nagent log\n")
    (jgy-agents-turn-test--write dir "clean.el" "new\n")
    ;; One shell invocation can write AND commit before the next scan.
    (jgy-agents-turn-test--git dir "add" ".")
    (jgy-agents-turn-test--git dir "commit" "-qm" "changes")
    (should (jgy-agents-turn-test--scan))
    (let* ((entry (cl-find (expand-file-name "project.md" dir) jgy-agents-turn--files
                           :key (lambda (row) (alist-get 'file row)) :test #'equal))
           (patch (alist-get 'diff entry))
           (files (copy-tree jgy-agents-turn--files)))
      (should (string-match-p "\n[+]agent log" patch))
      (should (string-match-p "\n user todo" patch))
      (should-not (string-match-p "\n[+]user todo" patch))
      (should (= 1 (alist-get 'added entry)))
      (should (numberp (alist-get 'line entry)))
      (should-not (jgy-agents-turn-test--scan))
      (should (equal files jgy-agents-turn--files))
      (jgy-agents-turn-test--git dir "commit" "--allow-empty" "-qm" "no content change")
      (should-not (jgy-agents-turn-test--scan))
      (should (equal files jgy-agents-turn--files)))
    (jgy-agents-turn-begin dir)
    (should-not jgy-agents-turn--files)
    (should (= 0 (hash-table-count (plist-get (car jgy-agents-turn--repos) :base))))
    (should-not (jgy-agents-turn-test--scan))))

(ert-deftest jgy-agents-turn-new-deleted-restored-and-untracked ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-test--write dir "old.txt" "old\n")
    (jgy-agents-turn-test--git dir "add" ".")
    (jgy-agents-turn-test--git dir "commit" "-qm" "initial")
    (jgy-agents-turn-test--write dir "draft.txt" "existing draft\n")
    (jgy-agents-turn-begin dir)
    (delete-file (expand-file-name "old.txt" dir))
    (jgy-agents-turn-test--write dir "draft.txt" "existing draft\nnew line\n")
    (jgy-agents-turn-test--write dir "new name.txt" "brand new\n")
    (should (jgy-agents-turn-test--scan))
    (should (= 3 (length jgy-agents-turn--files)))
    (let ((patches (mapconcat (lambda (row) (alist-get 'diff row)) jgy-agents-turn--files "")))
      (should (string-match-p "+++ /dev/null" patches))
      (should (string-match-p "--- /dev/null" patches))
      (should (string-match-p "\n[+]brand new" patches))
      (should (string-match-p "\n existing draft" patches)))
    (jgy-agents-turn-test--write dir "old.txt" "old\n")
    (should (jgy-agents-turn-test--scan))
    (should (equal "" (alist-get 'diff (car (last jgy-agents-turn--files)))))
    (should-not (jgy-agents-turn-test--scan))))

(ert-deftest jgy-agents-turn-nested-repos-and-subdirectory ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-test--write dir ".gitignore" "project/code/\n")
    (make-directory (expand-file-name "project/code" dir) t)
    (let ((root (expand-file-name "project" dir))
          (code (expand-file-name "project/code" dir)))
      (jgy-agents-turn-test--write root "project.md" "before\n")
      (jgy-agents-turn-test--git dir "add" ".")
      (jgy-agents-turn-test--git dir "commit" "-qm" "workspace")
      (jgy-agents-turn-test--git code "init" "-q")
      (jgy-agents-turn-test--write code "code.el" "before\n")
      (jgy-agents-turn-test--git code "add" ".")
      (jgy-agents-turn-test--git code "commit" "-qm" "code")
      (jgy-agents-turn-begin root)
      (should (= 2 (length jgy-agents-turn--repos)))
      (jgy-agents-turn-test--write root "project.md" "after\n")
      (jgy-agents-turn-test--write code "code.el" "after\n")
      (should (jgy-agents-turn-test--scan))
      (should (= 2 (length jgy-agents-turn--files)))
      (dolist (entry jgy-agents-turn--files)
        (should (string-match-p "\n-before\n[+]after" (alist-get 'diff entry)))))))

(ert-deftest jgy-agents-turn-unborn-repo-and-skip-binary ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-test--write dir "draft" "before\n")
    (jgy-agents-turn-test--write dir "binary" "a\0b")
    (jgy-agents-turn-begin dir)
    (jgy-agents-turn-test--write dir "draft" "after\n")
    (jgy-agents-turn-test--write dir "binary" "c\0d")
    (jgy-agents-turn-test--git dir "add" ".")
    (jgy-agents-turn-test--git dir "commit" "-qm" "first")
    (should (jgy-agents-turn-test--scan))
    (should (= 1 (length jgy-agents-turn--files)))
    (should (string-match-p "\n-before\n[+]after" (alist-get 'diff (car jgy-agents-turn--files))))))

(ert-deftest jgy-agents-turn-keeps-current-on-ambiguous-batch ()
  (let* ((a '((file . "a") (diff . "old")))
         (b '((file . "b") (diff . "new")))
         (c '((file . "c") (diff . "new"))))
    (should-not (jgy-agents-follow--latest (list a) (list a b c) "a"))
    (should (equal b (jgy-agents-follow--latest (list a) (list a b) "a")))
    (should (equal b (jgy-agents-follow--latest nil (list b c) "b")))))

(require 'jgy-agent-shell)
(ert-deftest jgy-agents-turn-event-lifecycle ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-test--write dir "file.txt" "before\n")
    (jgy-agents-turn-test--git dir "add" ".")
    (jgy-agents-turn-test--git dir "commit" "-qm" "initial")
    (setq jgy-agents-identity `((root . ,dir))
          jgy-agents-follow--state '(:files nil :file nil))
    (cl-letf (((symbol-function 'jgy-agents-refresh) #'ignore)
              ((symbol-function 'display-buffer) (lambda (&rest _) nil)))
      (unwind-protect
          (progn
            (jgy-agent-shell--on-event '((:event . input-submitted)))
            (jgy-agents-turn-test--write dir "file.txt" "after\n")
            (jgy-agents-turn-test--git dir "add" ".")
            (jgy-agents-turn-test--git dir "commit" "-qm" "change")
            (jgy-agent-shell--on-event
             '((:event . tool-call-update) (:data (:tool-call (:kind . "execute") (:status . "completed")))))
            (jgy-agents-turn-test--drain)
            (should (= 1 (length (jgy-agent-shell--files))))
            (jgy-agents-follow--show (current-buffer) (car (jgy-agent-shell--files)))
            (let ((patch (alist-get 'diff (car (jgy-agent-shell--files)))))
              (jgy-agent-shell--on-event '((:event . turn-complete)))
              (jgy-agents-turn-test--drain)
              (should (equal patch (alist-get 'diff (car (jgy-agent-shell--files)))))
              (jgy-agent-shell--on-event '((:event . input-submitted)))
              (should-not (jgy-agent-shell--files))
              (with-current-buffer (jgy-agents-follow--buffer-name (current-buffer))
                (should (equal patch (buffer-string)))
                (should (string-prefix-p "Previous turn" header-line-format)))))
        (when-let* ((diff (get-buffer (jgy-agents-follow--buffer-name (current-buffer)))))
          (kill-buffer diff))))))

(ert-deftest jgy-agents-turn-empty-file-and-relative-path ()
  (jgy-agents-turn-test--repo
    (make-directory (expand-file-name "sub" dir))
    (jgy-agents-turn-begin dir)
    (jgy-agents-turn-test--write dir "sub/empty" "")
    (should (jgy-agents-turn-test--scan))
    (let ((entry (car jgy-agents-turn--files)))
      (should (equal (alist-get 'directory entry) (file-name-as-directory dir)))
      (should (equal (alist-get 'diff entry) "--- /dev/null\n+++ b/sub/empty\n"))
      (should (= 0 (alist-get 'added entry))))))

(ert-deftest jgy-agents-turn-readonly-dedupe-and-coalesce ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-begin dir)
    (dotimes (i 20)
      (jgy-agents-turn-tool i '((:kind . "read") (:status . "completed"))))
    (should-not jgy-agents-turn--pending)
    (should-not jgy-agents-turn--timer)
    (jgy-agents-turn-tool "shell" '((:kind . "execute") (:status . "failed")))
    (let ((timer jgy-agents-turn--timer))
      (dotimes (_ 20)
        (jgy-agents-turn-tool "shell" '((:kind . "execute") (:status . "failed"))))
      (should (eq timer jgy-agents-turn--timer)))
    (jgy-agents-turn-test--drain)
    (jgy-agents-turn-tool "shell" '((:kind . "execute") (:status . "failed")))
    (should-not jgy-agents-turn--pending)))

(ert-deftest jgy-agents-turn-targeted-edit-and-new-line ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-test--write dir "code" "old\n")
    (jgy-agents-turn-test--write dir "unrelated" "user draft\n")
    (jgy-agents-turn-begin dir)
    (let* ((path (expand-file-name "code" dir))
           (reads nil) (reader (symbol-function 'jgy-agents-turn--read)))
      (cl-letf (((symbol-function 'jgy-agents-turn--read)
                 (lambda (file) (push file reads) (funcall reader file))))
        (jgy-agents-turn-test--write dir "code" "first\n")
        (jgy-agents-turn-tool "edit1"
                            `((:kind . "edit") (:status . "completed")
                              (:locations . [((path . ,path) (line . 12))])))
        (jgy-agents-turn-test--drain)
        (should (equal reads (list path)))
        (should (= 12 (alist-get 'line (car jgy-agents-turn--files))))
        (jgy-agents-turn-test--write dir "code" "second\n")
        (jgy-agents-turn-tool "edit2"
                            `((:kind . "edit") (:status . "completed")
                              (:diffs . (((:file . ,path) (:line . 90))))))
        (jgy-agents-turn-test--drain)
        (should (= 90 (alist-get 'line (car jgy-agents-turn--files))))
        (should (alist-get 'active (car jgy-agents-turn--files)))))))

(ert-deftest jgy-agents-turn-final-finds-missing-event-and-freezes ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-begin dir)
    (jgy-agents-turn-test--write dir "missed" "change\n")
    (jgy-agents-turn-request nil nil t)
    (jgy-agents-turn-test--drain)
    (should (= 1 (length jgy-agents-turn--files)))
    (let ((files (copy-tree jgy-agents-turn--files)))
      (jgy-agents-turn-test--write dir "missed" "later\n")
      (jgy-agents-turn-tool "late" '((:kind . "execute") (:status . "completed")))
      (should-not jgy-agents-turn--pending)
      (should (equal files jgy-agents-turn--files)))))

(ert-deftest jgy-agents-turn-cancel-running-worker-on-new-turn ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-begin dir)
    (jgy-agents-turn-test--write dir "old-turn" "change\n")
    (setq jgy-agents-turn--pending t)
    (jgy-agents-turn--start)
    (should (processp jgy-agents-turn--process))
    (let ((process jgy-agents-turn--process)
          (generation jgy-agents-turn--generation))
      (jgy-agents-turn-begin dir)
      (should (> jgy-agents-turn--generation generation))
      (should-not (process-live-p process))
      (accept-process-output nil 0.05)
      (should-not jgy-agents-turn--files)
      (should-not jgy-agents-turn--iterator)
      (should-not (jgy-agents-turn-test--scan)))))

(ert-deftest jgy-agents-turn-final-queues-behind-running-worker ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-begin dir)
    (setq jgy-agents-turn--pending t)
    (jgy-agents-turn--start)
    (let ((process jgy-agents-turn--process))
      (jgy-agents-turn-test--write dir "last" "late change\n")
      (jgy-agents-turn-request nil nil t)
      (should (eq process jgy-agents-turn--process))
      (should (eq t jgy-agents-turn--pending)))
    (jgy-agents-turn-test--drain)
    (should (= 1 (length jgy-agents-turn--files)))))

(ert-deftest jgy-agents-turn-coalesced-edits-follow-last-explicit-target ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-begin dir)
    (dolist (name '("z-first" "a-last"))
      (jgy-agents-turn-test--write dir name "new\n")
      (let ((path (expand-file-name name dir)))
        (jgy-agents-turn-tool name
                            `((:kind . "edit") (:status . "completed")
                              (:diffs . (((:file . ,path) (:line . 1))))))))
    (jgy-agents-turn-test--drain)
    (let ((latest (jgy-agents-follow--latest nil jgy-agents-turn--files)))
      (should (equal (alist-get 'file latest) (expand-file-name "a-last" dir))))
    (let ((before (copy-tree jgy-agents-turn--files)))
      (jgy-agents-turn-request nil nil t)
      (jgy-agents-turn-test--drain)
      (should (equal before jgy-agents-turn--files)))))

(ert-deftest jgy-agents-turn-cleared-focus-does-not-masquerade-as-edit ()
  (let ((old '(((file . "a") (diff . "old") (active . t))))
        (new '(((file . "a") (diff . "old") (active . nil))
               ((file . "b") (diff . "new") (active . nil)))))
    (should (equal "b" (alist-get 'file (jgy-agents-follow--latest old new "a"))))))

(ert-deftest jgy-agents-turn-final-verifies-content-despite-identical-stamp ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-test--write dir "file" "before\n")
    (cl-letf (((symbol-function 'jgy-agents-turn--stamp) (lambda (_) 'same)))
      (jgy-agents-turn-begin dir)
      (jgy-agents-turn-test--write dir "file" "after!\n")
      (should-not (jgy-agents-turn-test--scan))
      (jgy-agents-turn-request nil nil t)
      (jgy-agents-turn-test--drain)
      (should (string-match-p "[+]after!" (alist-get 'diff (car jgy-agents-turn--files)))))))

(ert-deftest jgy-agents-turn-targeted-ignore-and-outside-boundary ()
  (jgy-agents-turn-test--repo
    (jgy-agents-turn-test--write dir ".gitignore" "ignored\n")
    (jgy-agents-turn-begin dir)
    (jgy-agents-turn-test--write dir "ignored" "private\n")
    (let ((path (expand-file-name "ignored" dir)))
      (jgy-agents-turn-request (list path "/outside/not-in-project") (list (cons path 1))))
