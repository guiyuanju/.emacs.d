;;; iuiw-notify-overlook-test.el --- Remote notification policy tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'overlook-agent-core)
(require 'iuiw-notify-overlook)

(defvar overlook-remote-mode nil)
(defvar overlook-usage--rows nil)

(defmacro iuiw-notify-overlook-test--agent (&rest body)
  `(with-temp-buffer
     (let ((overlook-remote-mode t)
           (overlook-agent-notify nil)
           (overlook-agent-turn-start-hook nil)
           (overlook-agent-turn-end-hook nil)
           (overlook-agent-attention-hook nil)
           (overlook-agent-changed-hook nil)
           (now 1000) sent)
       (setq-local overlook-agent-identity '((agent . "test")))
       (cl-letf (((symbol-function 'float-time) (lambda (&rest _) now))
                 ((symbol-function 'iuiw-notify-overlook--unlocked-p) #'ignore)
                 ((symbol-function 'overlook-refresh) #'ignore)
                 ((symbol-function 'iuiw-notify-send)
                  (lambda (&rest args) (push args sent))))
         ,@body))))

(ert-deftest iuiw-notify-overlook-remote-gates-all-events ()
  (iuiw-notify-overlook-test--agent
   (setq overlook-remote-mode nil)
   (overlook-agent-report 'working)
   (overlook-agent-report 'attention)
   (overlook-agent-report 'failed)
   (should-not sent)
   (setq overlook-remote-mode t)
   (overlook-agent-report 'working)
   (overlook-agent-report 'attention)
   (should (= (length sent) 1))
   (setq overlook-remote-mode nil)
   (overlook-agent-report 'failed)
   (should (= (length sent) 1))))

(ert-deftest iuiw-notify-overlook-deduplicates-each-kind-per-turn ()
  (iuiw-notify-overlook-test--agent
   (overlook-agent-report 'working)
   (overlook-agent-report 'attention)
   (overlook-agent-report 'attention)
   (overlook-agent-report 'working)
   (overlook-agent-report 'attention)
   (should (= (length sent) 1))
   (overlook-agent-report 'failed)
   (overlook-agent-report 'failed)
   (should (= (length sent) 2))
   (setq now 1200)
   (overlook-agent-report 'working)
   (overlook-agent-report 'attention)
   (should (= (length sent) 3))))

(ert-deftest iuiw-notify-overlook-only-long-completions ()
  (iuiw-notify-overlook-test--agent
   (overlook-agent-report 'working)
   (setq now 1010)
   (overlook-agent-report 'finished)
   (should-not sent)
   (setq now 1100)
   (overlook-agent-report 'working)
   (setq now 1160)
   (overlook-agent-report 'finished)
   (overlook-agent-report 'finished)
   (should (= (length sent) 1))
   (should (equal (caar sent) "Agent 已完成"))))

(ert-deftest iuiw-notify-overlook-question-at-turn-end-needs-attention ()
  (iuiw-notify-overlook-test--agent
   (let ((overlook-agent--focused-function #'ignore))
     (cl-letf (((symbol-function 'overlook-agent-reply-question) (lambda (_) t)))
       (overlook-agent-report 'working)
       (setq now 1010)
       (overlook-agent-report 'finished)
       (should (equal (caar sent) "Agent 需要你处理"))))))

(ert-deftest iuiw-notify-overlook-quota-waits-for-all-windows ()
  (let ((overlook-remote-mode t)
        (iuiw-notify-overlook--quotas (make-hash-table :test #'equal))
        (overlook-usage--rows '(("claude" ("5h" 100 1100) ("week" 100 1200))))
        (now 1000) sent)
    (cl-letf (((symbol-function 'float-time) (lambda () now))
              ((symbol-function 'iuiw-notify-overlook--unlocked-p) #'ignore)
              ((symbol-function 'iuiw-notify-send) (lambda (&rest args) (push args sent))))
      (iuiw-notify-overlook--usage)
      (setq now 1101)
      (iuiw-notify-overlook--usage)
      (should-not sent)
      (setq now 1201)
      (iuiw-notify-overlook--usage)
      (iuiw-notify-overlook--usage)
      (should (= (length sent) 1))
      (setq overlook-usage--rows '(("claude" ("5h" 100 1400))))
      (iuiw-notify-overlook--usage)
      (setq overlook-usage--rows '(("claude" ("5h" 0 1400))))
      (iuiw-notify-overlook--usage)
      (should (= (length sent) 2)))))

(ert-deftest iuiw-notify-overlook-quota-skips-old-unknown-and-disabled ()
  (let ((overlook-remote-mode t)
        (iuiw-notify-overlook--quotas (make-hash-table :test #'equal))
        (overlook-usage--rows '(("old" ("5h" 100 900))
                                ("unknown" ("5h" 100 nil))
                                ("fresh" ("5h" 100 1200))))
        (now 1000) sent)
    (cl-letf (((symbol-function 'float-time) (lambda () now))
              ((symbol-function 'iuiw-notify-overlook--unlocked-p) #'ignore)
              ((symbol-function 'iuiw-notify-send) (lambda (&rest args) (push args sent))))
      (iuiw-notify-overlook--usage)
      (should (= (hash-table-count iuiw-notify-overlook--quotas) 1))
      (setq overlook-remote-mode nil now 1300)
      (iuiw-notify-overlook--remote-changed)
      (iuiw-notify-overlook--usage)
      (setq overlook-remote-mode t)
      (iuiw-notify-overlook--usage)
      (should-not sent))))

(provide 'iuiw-notify-overlook-test)

(ert-deftest iuiw-notify-overlook-skips-while-unlocked ()
  (iuiw-notify-overlook-test--agent
   (cl-letf (((symbol-function 'iuiw-notify-overlook--unlocked-p) (lambda () t)))
     (overlook-agent-report 'working)
     (overlook-agent-report 'attention))
   (should-not sent)
   (overlook-agent-report 'failed)
   (should (= (length sent) 1))))

(ert-deftest iuiw-notify-overlook-reads-the-console-lock ()
  (let ((system-type 'darwin) (output nil))
    (cl-letf (((symbol-function 'call-process)
               (lambda (&rest _) (insert output) 0)))
      (setq output "  \"IOConsoleLocked\" = No\n")
      (should (iuiw-notify-overlook--unlocked-p))
      (setq output "  \"IOConsoleLocked\" = Yes\n")
      (should-not (iuiw-notify-overlook--unlocked-p))
      (setq output "")
      (should-not (iuiw-notify-overlook--unlocked-p)))))

;;; iuiw-notify-overlook-test.el ends here
