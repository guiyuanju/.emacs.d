#!/bin/sh
# Open an SSH ControlMaster connection to HOST unless one is up; later ssh and
# git commands through HOST reuse it.  Prompts (the jump host's OTP) go to the
# running Emacs through iuiw-ssh-askpass.  Exits non-zero with ssh's error.
host=${1:?usage: iuiw-ssh-master HOST}
ssh -O check "$host" 2>/dev/null && exit 0
SSH_ASKPASS="$(cd "$(dirname "$0")" && pwd)/iuiw-ssh-askpass" \
SSH_ASKPASS_REQUIRE=force \
exec ssh -MNf "$host" </dev/null
