#!/bin/sh
# Claude Code status line; ghostel-agents reads the "ctx N%" part off the screen
# and the plan usage from the file written here.
input=$(cat)
dir=${XDG_CACHE_HOME:-$HOME/.cache}
mkdir -p "$dir"
printf '%s' "$input" | jq -c '.rate_limits // empty' > "$dir/claude-usage.json.$$"
if [ -s "$dir/claude-usage.json.$$" ]; then
  mv "$dir/claude-usage.json.$$" "$dir/claude-usage.json"
else
  rm -f "$dir/claude-usage.json.$$"
fi
printf '%s' "$input" | jq -r '[.model.display_name, (.context_window.used_percentage // empty | "ctx \(floor)%")] | join(" · ")'
