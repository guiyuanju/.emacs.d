#!/bin/sh
# Claude Code status line.  Inside a ghostel-agents agent it also writes the
# context usage to a file named by the agent id, for Emacs to pick up.
input=$(cat)
if [ -n "$GHOSTEL_AGENTS_ID" ] && [ -d "$GHOSTEL_AGENTS_CONTEXT_DIR" ]; then
  out="$GHOSTEL_AGENTS_CONTEXT_DIR/$GHOSTEL_AGENTS_ID.json"
  printf '%s' "$input" |
    jq -c '.context_window | {used_percentage, context_window_size}' > "$out.tmp" &&
    mv "$out.tmp" "$out"
fi
printf '%s' "$input" |
  jq -r '[.model.display_name, (.context_window.used_percentage // empty | "ctx \(floor)%")] | join(" · ")'
