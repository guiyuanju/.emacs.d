        (idle nil)
        (overlook--timer nil))
    (cl-letf (((symbol-function 'overlook--render) (lambda () (cl-incf rendered)))
              ((symbol-function 'current-idle-time) (lambda () idle)))
      (overlook--render-when-idle (float-time))
      (should (= rendered 0))
      (should (timerp overlook--timer))
      (cancel-timer overlook--timer)
      (setq idle (seconds-to-time 1))
      (overlook--render-when-idle (float-time))
