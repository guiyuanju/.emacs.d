      (should-not overlook--timer)
      (setq idle nil)
      (overlook--render-when-idle (- (float-time) overlook-refresh-max-wait))
      (should (= rendered 2)))))

(ert-deftest overlook-repo-reads-a-few-repos-at-once ()
