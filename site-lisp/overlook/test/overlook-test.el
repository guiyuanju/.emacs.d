(ert-deftest overlook-watchdog-reports-stuck-agents-once ()
  (require 'overlook-watchdog)
  (let* ((overlook-courier--agents (make-hash-table :test #'equal))
         (overlook-courier--delivery-timer nil)
         (overlook-courier--retry-timer nil)
         (overlook-courier-event--keys (make-hash-table :test #'equal))
         (overlook-courier-event--key-order nil)
         (overlook-courier-event-log nil)
         (overlook-watchdog--waiting (make-hash-table :test #'eq))
         (worker (overlook-test--agent "worker"))
         (mine (overlook-test--agent "mine"))
         (published nil)
         (now (float-time)))
    (unwind-protect
        (cl-letf (((symbol-function 'overlook-agent-buffers) (lambda (&rest _) (list worker mine)))
                  ((symbol-function 'overlook-agent--brief) (lambda (_) "Running tests"))
                  ((symbol-function 'overlook-courier-room-publish)
                   (lambda (room source text fallback) (push (list room source text fallback) published))))
          (overlook-courier-register "router")
          (overlook-courier-register "w@p" :buffer worker :parent "router" :ready #'always)
          (overlook-courier-register "m@p" :buffer mine :ready #'always)
          (dolist (buffer (list worker mine))
            (with-current-buffer buffer
              (setq overlook-agent-courier-id (if (eq buffer worker) "w@p" "m@p")
                    overlook-agent-turn (list (- now 3600)))))
          (overlook-watchdog-check)
          (should (= (length published) 1))
          (should (string-search "w@p has run one turn for 60 min" (nth 2 (car published))))
          (should (equal (nth 3 (car published)) "router"))
          (overlook-watchdog--stalled "m@p" (- now 600))
          (should (string-search "delivered to m@p 10 min ago" (nth 2 (car published))))
          (should-not (nth 3 (car published)))
          (overlook-watchdog-check)
          (should (= (length published) 2))
          (with-current-buffer worker
            (setq overlook-agent-turn (list (- now 3600) (- now 60))
                  overlook-agent-status 'waiting))
          (overlook-watchdog-check)
          (should (= (length published) 2))
          (puthash worker (- now 1000) overlook-watchdog--waiting)
          (overlook-watchdog-check)
          (should (string-search "w@p has waited for the user for 17 min" (nth 2 (car published))))
          (with-current-buffer worker (setq overlook-agent-status 'idle))
          (overlook-watchdog-check)
          (should-not (gethash worker overlook-watchdog--waiting)))
      (kill-buffer worker)
      (kill-buffer mine))))

