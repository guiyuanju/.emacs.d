;;; overlook-model-test.el --- Model boundaries and update lifecycle -*- lexical-binding: t; -*-

(require 'ert)
(require 'overlook-model)

(ert-deftest overlook-model-and-agent-state-load-without-the-emacs-view ()
  (with-temp-buffer
    (let* ((root (file-name-directory (locate-library "overlook-model")))
           (form `(progn
                    (require 'cl-lib)
                    (require 'overlook-agent-core)
                    (require 'overlook-remote-model)
                    (let* ((overlook-sections (list (lambda () (overlook-row :content "hello"))))
                           (first (overlook-model)))
                      (cl-assert (equal (overlook-row-text (car first)) "hello"))
                      (cl-assert (equal (plist-get (aref (overlook-remote--spans (car first)) 0)
                                                   :text)
                                        "hello"))
                      (cl-assert (eq first (overlook-latest-model)))
                      (overlook-refresh)
                      (cl-assert (not (overlook-model-fresh-p)))
                      (cl-assert (not (eq first (overlook-latest-model)))))
                    (cl-assert (not (featurep 'overlook)))
                    (cl-assert (not (featurep 'magit-section)))
                    (cl-assert (not (featurep 'overlook-agent-session)))
                    (cl-assert (not (featurep 'overlook-agent-view)))))
           (status (call-process (expand-file-name invocation-name invocation-directory)
                                 nil t nil "-Q" "--batch" "-L" root "--eval"
                                 (prin1-to-string form))))
      (unless (eql status 0) (ert-fail (buffer-string))))))

(ert-deftest overlook-updates-share-one-timer-until-the-last-view-leaves ()
  (let ((overlook--update-consumers nil)
        (overlook--tick-timer nil)
        (ticks 0))
    (let ((overlook-tick-hook (list (lambda () (cl-incf ticks)))))
      (unwind-protect
          (progn
            (overlook-start-updates 'remote)
            (let ((timer overlook--tick-timer))
              (overlook-start-updates 'remote)
              (overlook-start-updates 'dashboard)
              (should (eq timer overlook--tick-timer))
              (should (= (length overlook--update-consumers) 2))
              (overlook--tick)
              (should (= ticks 1))
              (overlook-stop-updates 'dashboard)
              (should (eq timer overlook--tick-timer))
              (overlook--tick)
              (should (= ticks 2))
              (overlook-stop-updates 'remote)
              (should-not overlook--tick-timer)
              (should-not (memq timer timer-list))
              (should-not (overlook-updating-p))
              (overlook--tick)
              (should (= ticks 2))))
        (when (timerp overlook--tick-timer) (cancel-timer overlook--tick-timer))))))
