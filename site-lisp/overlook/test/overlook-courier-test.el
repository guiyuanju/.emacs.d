;;; overlook-courier-test.el --- Tests for courier -*- lexical-binding: t; -*-

(require 'ert)
(require 'overlook-courier)
(require 'overlook-courier-persona)
(require 'overlook-courier-worktree)

(defvar overlook-courier-test--inbox nil
  "Alist of agent id to the prompts delivered to it, newest first.")

(defvar overlook-courier-test--busy nil
  "Ids of the fake agents not ready for a prompt.")

(defvar overlook-courier-test--replies nil
  "Alist of agent id to its last reply.")

(defvar overlook-courier-test--drafts nil
  "Alist of agent id to the drafts left at its prompt, newest first.")

(defmacro overlook-courier-test-with-agents (ids &rest body)
  "Run BODY with fresh fake agents IDS registered."
  (declare (indent 1))
  `(let ((overlook-courier--agents (make-hash-table :test #'equal))
         (overlook-courier--retry-timer nil)
         (overlook-courier--delivery-timer nil)
         (overlook-courier-test--inbox nil)
         (overlook-courier-test--busy nil)
         (overlook-courier-test--replies nil)
         (overlook-courier-test--drafts nil))
     (unwind-protect
         (progn
           (mapc #'overlook-courier-test--register ,ids)
           ,@body)
       (when (timerp overlook-courier--retry-timer) (cancel-timer overlook-courier--retry-timer))
       (when (timerp overlook-courier--delivery-timer) (cancel-timer overlook-courier--delivery-timer)))))

(defun overlook-courier-test--register (id &optional parent)
  "Register fake agent ID, spawned by PARENT."
  (overlook-courier-register id
                    :parent parent
                    :deliver (lambda (text) (push text (alist-get id overlook-courier-test--inbox nil nil #'equal)))
                    :ready (lambda () (not (member id overlook-courier-test--busy)))
                    :reply (lambda () (alist-get id overlook-courier-test--replies nil nil #'equal))
                    :insert (lambda (text) (push text (alist-get id overlook-courier-test--drafts nil nil #'equal)))))

(defun overlook-courier-test--received (id)
  "Prompts delivered to ID, oldest first."
  (reverse (alist-get id overlook-courier-test--inbox nil nil #'equal)))

(ert-deftest overlook-courier-send-waits-until-the-agent-is-ready ()
  (overlook-courier-test-with-agents '("a@p" "b@p")
    (push "b@p" overlook-courier-test--busy)
    (overlook-courier-send "b@p" "one" "a@p")
    (overlook-courier-send "b@p" "two" "a@p")
    (overlook-courier-deliver)
    (should-not (overlook-courier-test--received "b@p"))
    (should (timerp overlook-courier--retry-timer))
    (setq overlook-courier-test--busy nil)
    (overlook-courier-deliver)
    (let ((prompts (overlook-courier-test--received "b@p")))
      (should (= (length prompts) 1))
      (should (string-match-p "From agent a@p.*courier send a@p" (car prompts)))
      (should (string-match-p "one\\(.\\|\n\\)*two" (car prompts))))
    (should-not overlook-courier--retry-timer)))

(ert-deftest overlook-courier-delivers-once-per-turn ()
  (overlook-courier-test-with-agents '("a@p" "b@p")
    (overlook-courier-send "b@p" "one" "a@p")
    (overlook-courier-deliver)
    (overlook-courier-send "b@p" "two" "a@p")
    (overlook-courier-deliver)
    (should (= (length (overlook-courier-test--received "b@p")) 1))
    (overlook-courier-turn-started "b@p")
    (overlook-courier-turn-finished "b@p")
    (overlook-courier-deliver)
    (should (= (length (overlook-courier-test--received "b@p")) 2))))

(ert-deftest overlook-courier-send-to-unknown-agent-errors ()
  (overlook-courier-test-with-agents '("a@p")
    (should-error (overlook-courier-send "nobody@p" "hi" "a@p") :type 'user-error)))

(ert-deftest overlook-courier-monitor-tells-once-with-the-reply ()
  (overlook-courier-test-with-agents '("a@p" "b@p")
    (overlook-courier-monitor "a@p" "b@p")
    (setf (alist-get "b@p" overlook-courier-test--replies nil nil #'equal) "all done")
    (overlook-courier-turn-finished "b@p")
    (overlook-courier-deliver)
    (should (string-match-p "b@p finished its turn.*\n\nall done"
                            (car (overlook-courier-test--received "a@p"))))
    (overlook-courier-turn-started "a@p")
    (overlook-courier-turn-finished "a@p")
    (overlook-courier-turn-finished "b@p")
    (overlook-courier-deliver)
    (should (= (length (overlook-courier-test--received "a@p")) 1))))

(ert-deftest overlook-courier-monitor-hears-when-the-agent-is-gone ()
  (overlook-courier-test-with-agents '("a@p")
    (let ((buffer (generate-new-buffer "b")))
      (overlook-courier-register "b@p" :buffer buffer :deliver #'ignore)
      (overlook-courier-monitor "a@p" "b@p")
      (kill-buffer buffer)
      (should-not (overlook-courier-agent "b@p"))
      (overlook-courier-deliver)
      (should (string-match-p "b@p is gone" (car (overlook-courier-test--received "a@p")))))))

(ert-deftest overlook-courier-spawn-briefs-the-child-and-reports-back ()
  (overlook-courier-test-with-agents '("a@p")
    (let* ((efforts nil)
           (overlook-courier-spawn-function
            (lambda (name directory parent effort &optional as)
              (push effort efforts)
              (let ((id (or as (overlook-courier-new-id name directory))))
                (overlook-courier-test--register id parent)
                id))))
      (should (equal (overlook-courier-spawn "codex" "/work/p/" "review foo.go" "a@p" "high") "codex@p"))
      (should (equal efforts '("high")))
      (overlook-courier-deliver)
      (let ((brief (car (overlook-courier-test--received "codex@p"))))
        (should (string-match-p "You are codex@p" brief))
        (should (string-match-p "a@p started you" brief))
        (should (string-suffix-p "review foo.go" brief)))
      (should (equal (overlook-courier-agent-parent (overlook-courier-agent "codex@p")) "a@p"))
      (overlook-courier-turn-started "codex@p")
      (setf (alist-get "codex@p" overlook-courier-test--replies nil nil #'equal) "looks fine")
      (overlook-courier-turn-finished "codex@p")
      (overlook-courier-deliver)
      (should (string-match-p "looks fine" (car (overlook-courier-test--received "a@p")))))))

(ert-deftest overlook-courier-spawn-handoff-leaves-the-child-to-the-user ()
  (overlook-courier-test-with-agents '("a@p")
    (let ((overlook-courier-spawn-function
           (lambda (name directory parent _effort &optional as)
             (let ((id (or as (overlook-courier-new-id name directory))))
               (overlook-courier-test--register id parent)
               id)))
          (output (make-temp-file "overlook-courier-out")))
      (unwind-protect
          (progn
            (overlook-courier-cli output (base64-encode-string "a@p")
                         (base64-encode-string "spawn")
                         (base64-encode-string "--handoff")
                         (base64-encode-string "codex")
                         (base64-encode-string "/work/p/")
                         (base64-encode-string "review foo.go"))
            (should (string-search "waits unsent" (with-temp-buffer
                                                    (insert-file-contents output)
                                                    (buffer-string))))
            (should-error (overlook-courier-options '("--handoff" "--effort") '("--effort") '("--handoff"))))
        (delete-file output))
      (should-not (overlook-courier-agent-parent (overlook-courier-agent "codex@p")))
      (push "codex@p" overlook-courier-test--busy)
      (overlook-courier-deliver)
      (should-not (alist-get "codex@p" overlook-courier-test--drafts nil nil #'equal))
      (setq overlook-courier-test--busy nil)
      (overlook-courier-deliver)
      (overlook-courier-deliver)
      (should (equal (alist-get "codex@p" overlook-courier-test--drafts nil nil #'equal) '("review foo.go")))
      (should-not (overlook-courier-test--received "codex@p"))
      (overlook-courier-turn-started "codex@p")
      (setf (alist-get "codex@p" overlook-courier-test--replies nil nil #'equal) "looks fine")
      (overlook-courier-turn-finished "codex@p")
      (overlook-courier-deliver)
      (should-not (overlook-courier-test--received "a@p")))))

(ert-deftest overlook-courier-link-skills-repairs-only-its-own-gaps ()
  (let* ((home (make-temp-file "overlook-courier-home" t))
         (claude (expand-file-name ".claude/skills/" home))
         (overlook-courier-skill-directories (list claude (expand-file-name ".codex/skills/" home))))
    (unwind-protect
        (progn
          (make-directory claude t)
          (make-symbolic-link (expand-file-name "gone" home) (expand-file-name "courier" claude))
          (make-directory (expand-file-name "courier-handoff" claude))
          (should (equal (overlook-courier-link-skills) (list (expand-file-name "courier" claude))))
          (should (file-exists-p (expand-file-name "courier/SKILL.md" claude)))
          (should-not (file-symlink-p (expand-file-name "courier-handoff" claude)))
          (should-not (file-exists-p (expand-file-name ".codex" home)))
          (should-not (overlook-courier-link-skills)))
      (delete-directory home t))))

(ert-deftest overlook-courier-new-id-stays-unique ()
  (overlook-courier-test-with-agents '("claude@shop")
    (should (equal (overlook-courier-new-id "claude" "/x/shop/") "claude@shop-2"))
    (should (equal (overlook-courier-new-id "codex" "/x/shop") "codex@shop"))))

(ert-deftest overlook-courier-drops-messages-past-max-hops ()
  (overlook-courier-test-with-agents '("a@p" "b@p")
    (let ((overlook-courier-max-hops 3)
          (inhibit-message t))
      ;; Two agents answering each other forever.
      (overlook-courier-send "b@p" "ping" "a@p")
      (dotimes (_ 10)
        (overlook-courier-deliver)
        (dolist (pair '(("a@p" . "b@p") ("b@p" . "a@p")))
          (when (overlook-courier-agent-delivered (overlook-courier-agent (car pair)))
            (overlook-courier-turn-started (car pair))
            (overlook-courier-send (cdr pair) "again" (car pair))
            (overlook-courier-turn-finished (car pair)))))
      (should (= (+ (length (overlook-courier-test--received "a@p"))
                    (length (overlook-courier-test--received "b@p")))
                 overlook-courier-max-hops)))))

(ert-deftest overlook-courier-human-turn-restarts-the-hops ()
  (overlook-courier-test-with-agents '("a@p" "b@p")
    (overlook-courier-send "b@p" "hi" "a@p")
    (overlook-courier-deliver)
    (overlook-courier-turn-started "b@p")
    (should (= (overlook-courier-agent-hops (overlook-courier-agent "b@p")) 1))
    (overlook-courier-turn-finished "b@p")
    (overlook-courier-turn-started "b@p")
    (should (= (overlook-courier-agent-hops (overlook-courier-agent "b@p")) 0))))

(ert-deftest overlook-courier-cli-decodes-arguments-and-writes-output ()
  (overlook-courier-test-with-agents '("a@p" "b@p")
    (let ((output (make-temp-file "overlook-courier-out"))
          (encode (lambda (s) (base64-encode-string (encode-coding-string s 'utf-8) t))))
      (unwind-protect
          (progn
            (should (overlook-courier-cli output (funcall encode "a@p") (funcall encode "send")
                                 (funcall encode "b@p") (funcall encode "看一下 \"x\"\n")))
            (overlook-courier-deliver)
            (should (string-match-p "看一下 \"x\"" (car (overlook-courier-test--received "b@p"))))
            (should-not (overlook-courier-cli output (funcall encode "a@p") (funcall encode "send")
                                     (funcall encode "zz@p") (funcall encode "hi")))
            (should (string-prefix-p "error: No agent zz@p"
                                     (with-temp-buffer (insert-file-contents output)
                                                       (buffer-string))))
            (overlook-courier-cli output "" (funcall encode "whoami"))
            (should (string-prefix-p "Not a courier agent"
                                     (with-temp-buffer (insert-file-contents output)
                                                       (buffer-string)))))
        (delete-file output)))))

(defmacro overlook-courier-test-with-child (&rest body)
  "Run BODY with agent a@p and its child c@p, which got a task from it."
  (declare (indent 0))
  `(overlook-courier-test-with-agents '("a@p")
     (overlook-courier-test--register "c@p" "a@p")
     (overlook-courier-send "c@p" "the task" "a@p")
     (overlook-courier-deliver)
     (overlook-courier-turn-started "c@p")
     (setf (alist-get "c@p" overlook-courier-test--replies nil nil #'equal) "my reply")
     ,@body))

(ert-deftest overlook-courier-child-report-replaces-its-reply ()
  (overlook-courier-test-with-child
    (overlook-courier-send "a@p" "found two bugs" "c@p")
    (overlook-courier-turn-finished "c@p")
    (overlook-courier-deliver)
    (let ((prompts (overlook-courier-test--received "a@p")))
      (should (= (length prompts) 1))
      (should (string-match-p "From agent c@p, not from your user" (car prompts)))
      (should (string-suffix-p "found two bugs" (car prompts))))))

(ert-deftest overlook-courier-child-that-does-not-report-sends-its-reply ()
  (overlook-courier-test-with-child
    (overlook-courier-turn-finished "c@p")
    (overlook-courier-deliver)
    (should (string-match-p "c@p finished its turn.*\n\nmy reply"
                            (car (overlook-courier-test--received "a@p"))))
    ;; A turn the user started is not the parent's business.
    (overlook-courier-turn-started "a@p")
    (overlook-courier-turn-finished "a@p")
    (overlook-courier-turn-started "c@p")
    (overlook-courier-turn-finished "c@p")
    (overlook-courier-deliver)
    (should (= (length (overlook-courier-test--received "a@p")) 1))))

(ert-deftest overlook-courier-child-error-reaches-the-parent-even-after-a-report ()
  (overlook-courier-test-with-child
    (overlook-courier-send "a@p" "half done" "c@p")
    (overlook-courier-turn-finished "c@p" "Overloaded")
    (overlook-courier-deliver)
    (should (string-match-p "half done\\(.\\|\n\\)*c@p hit an error: Overloaded"
                            (car (overlook-courier-test--received "a@p"))))))

(ert-deftest overlook-courier-child-waiting-for-the-user-tells-the-parent-once-a-turn ()
  (overlook-courier-test-with-child
    (overlook-courier-blocked "c@p" "⚠ Bash rm -rf build")
    (overlook-courier-blocked "c@p" "⚠ Bash rm -rf dist")
    (overlook-courier-send "a@p" "done" "c@p")
    (overlook-courier-turn-finished "c@p")
    (overlook-courier-deliver)
    (let ((prompt (car (overlook-courier-test--received "a@p"))))
      (should (string-match-p "c@p is waiting for the user: ⚠ Bash rm -rf build" prompt))
      (should-not (string-match-p "dist" prompt)))
    (overlook-courier-turn-started "a@p")
    (overlook-courier-turn-finished "a@p")
    (overlook-courier-turn-started "c@p")
    (overlook-courier-blocked "c@p" "? Which branch")
    (overlook-courier-deliver)
    ;; Only the user can answer, so the parent is not woken for it.
    (should (= (length (overlook-courier-test--received "a@p")) 1))
    (overlook-courier-send "a@p" "next" "c@p")
    (overlook-courier-deliver)
    (should (string-match-p "Which branch\\(.\\|\n\\)*next" (cadr (overlook-courier-test--received "a@p"))))))

(ert-deftest overlook-courier-parent-hears-when-its-child-is-gone ()
  (overlook-courier-test-with-agents '("a@p")
    (let ((buffer (generate-new-buffer "c")))
      (overlook-courier-register "c@p" :buffer buffer :deliver #'ignore :parent "a@p")
      (kill-buffer buffer)
      (overlook-courier-deliver)
      ;; It owed no report, so the parent learns of it with its next prompt.
      (should-not (overlook-courier-test--received "a@p"))
      (overlook-courier-send "a@p" "hi")
      (overlook-courier-deliver)
      (should (string-match-p "c@p is gone\\(.\\|\n\\)*hi" (car (overlook-courier-test--received "a@p")))))))

(ert-deftest overlook-courier-child-gone-before-reporting-wakes-the-parent ()
