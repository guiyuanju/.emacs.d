      (overlook-courier-register "c@p" :buffer buffer :deliver #'ignore :parent "a@p")
      (overlook-courier-send "c@p" "the task" "a@p")
      (overlook-courier-deliver)
      (kill-buffer buffer)
      (overlook-courier-deliver)
      (should (string-match-p "c@p is gone" (car (overlook-courier-test--received "a@p")))))))

(ert-deftest overlook-courier-cuts-a-long-reply-from-its-start ()
