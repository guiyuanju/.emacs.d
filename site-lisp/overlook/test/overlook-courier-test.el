(defmacro overlook-courier-test-with-personas (ids &rest body)
  "Run BODY with fake agents IDS and a persona reviewer, all fresh."
  (declare (indent 1))
  `(let* ((root (make-temp-file "overlook-courier-personas" t))
          (overlook-courier-persona-directories (list (expand-file-name "personas/" root)))
          (overlook-courier-test--spawned nil)
          (overlook-courier-spawn-function
           (lambda (name directory parent effort &optional as)
             (push (list name directory parent effort as) overlook-courier-test--spawned)
             (let ((id (or as (overlook-courier-new-id name directory))))
               (overlook-courier-test--register id parent)
               id))))
     (make-directory (expand-file-name "personas/reviewer/memory" root) t)
     (with-temp-file (expand-file-name "personas/reviewer/persona.md" root)
       (insert "---\nengine: codex\neffort: high\ndescription: Reviews diffs\n"
               "avatar: 🦉\npersonality: exacting\ntone:\n---\nYou review code; you never edit it.\n"))
     (with-temp-file (expand-file-name "personas/reviewer/memory/MEMORY.md" root)
       (insert "- [Short reports](short.md) — the user wants findings only\n"))
     (unwind-protect
         (overlook-courier-test-with-agents ,ids ,@body)
       (delete-directory root t))))

(defvar overlook-courier-test--spawned nil
  "Arguments of each call to the fake spawn function, newest first.")

(ert-deftest overlook-courier-persona-reads-its-folder ()
  (overlook-courier-test-with-personas '()
    (should (equal (overlook-courier-persona-names) '("reviewer")))
    (let ((persona (overlook-courier-persona "reviewer")))
      (should (equal (plist-get persona :engine) "codex"))
      (should (equal (plist-get persona :avatar) "🦉"))
      (should-not (plist-get persona :tone))
      (should (equal (plist-get persona :body) "You review code; you never edit it."))
      (should (equal (overlook-courier-persona-directory persona) (file-name-as-directory root)))
      (let ((briefing (overlook-courier-persona-briefing persona "codex")))
        (should (string-search "You are reviewer, a persona" briefing))
        (should (string-search "You review code" briefing))
        (should (string-search "Personality: exacting" briefing))
        (should-not (string-search "Tone:" briefing))
        (should (string-search "[Short reports](short.md)" briefing))))))

(ert-deftest overlook-courier-persona-without-memory ()
  (overlook-courier-test-with-personas '()
    (let ((persona (append '(:memory "off") (overlook-courier-persona "reviewer"))))
      (should-not (overlook-courier-persona-remembers-p persona))
      (should-not (string-search "Your memory" (overlook-courier-persona-briefing persona "codex"))))
    (should (overlook-courier-persona-remembers-p (overlook-courier-persona "reviewer")))))

(ert-deftest overlook-courier-persona-starts-under-its-own-id ()
  (overlook-courier-test-with-personas '("a@p")
    (should (equal (overlook-courier-persona-start "reviewer" :task "Review x.go" :from "a@p") "reviewer"))
    (should (equal (car overlook-courier-test--spawned)
                   (list "codex" (file-name-as-directory root) "a@p" "high" "reviewer")))
    (overlook-courier-deliver)
    (let ((prompt (car (overlook-courier-test--received "reviewer"))))
      (should (string-search "You are reviewer, a persona" prompt))
      (should (string-suffix-p "Review x.go" prompt)))
    (should-error (overlook-courier-persona-start "reviewer"))
    (should (string-search "reviewer  running, codex  Reviews diffs"
                           (overlook-courier-persona-cli "a@p" '("list"))))))

(ert-deftest overlook-courier-persona-runs-several-times-with-multiple-on ()
  (overlook-courier-test-with-personas '("a@p")
    (with-temp-file (expand-file-name "personas/reviewer/persona.md" root)
      (insert "---\nengine: codex\nmultiple: on\nbriefing: off\n---\n"))
    (should (equal (overlook-courier-persona-start "reviewer") "reviewer"))
    (should (equal (overlook-courier-persona-start "reviewer") "reviewer-2"))
    (should (equal (overlook-courier-persona-start "reviewer") "reviewer-3"))
    (should (equal (overlook-courier-persona-of "reviewer-2") "reviewer"))
    (should-not (overlook-courier-persona-of "a@p"))
    (should (equal (overlook-courier-persona-instances "reviewer")
                   '("reviewer" "reviewer-2" "reviewer-3")))
    (should (string-search "reviewer  3 running"
                           (overlook-courier-persona-cli "a@p" '("list"))))))

(ert-deftest overlook-courier-persona-instance-needs-multiple ()
