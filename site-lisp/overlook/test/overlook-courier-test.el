;;; Worktrees

(defun overlook-courier-test--repo (dir)
  "Make DIR a Git repo with one commit."
  (make-directory dir t)
  (let ((default-directory (file-name-as-directory dir)))
    (call-process "git" nil nil nil "init" "-q" "-b" "main")
    (call-process "git" nil nil nil "-c" "user.name=t" "-c" "user.email=t@t"
                  "commit" "-q" "--allow-empty" "-m" "start")))

(defun overlook-courier-test--branch (dir)
  "The branch checked out in DIR."
  (let ((default-directory (file-name-as-directory dir)))
    (string-trim (shell-command-to-string "git branch --show-current"))))

(defmacro overlook-courier-test-with-tmp (var &rest body)
  "Run BODY with VAR bound to a fresh temporary directory."
  (declare (indent 1))
  `(let ((,var (file-name-as-directory (file-truename (make-temp-file "overlook-courier-wt" t)))))
     (unwind-protect (progn ,@body) (delete-directory ,var t))))

(ert-deftest overlook-courier-worktree-of-a-repo ()
  (overlook-courier-test-with-tmp root
    (overlook-courier-test--repo root)
    (let ((path (overlook-worktree-add root "fix/login")))
      (should (equal path (expand-file-name ".worktrees/fix-login/" root)))
      (should (equal (overlook-courier-test--branch path) "fix/login"))
      (should (equal (overlook-worktree-add root "fix/login") path))
      (should (equal (overlook-worktree-list root) '("fix-login")))
      (let ((default-directory root))
        (should (string-empty-p (shell-command-to-string "git status --porcelain"))))
      (overlook-worktree-remove root "fix/login")
      (should-not (file-exists-p path))
      (should (equal (overlook-courier-test--branch root) "main"))
      (let ((default-directory root))
        (should (string-search "fix/login" (shell-command-to-string "git branch")))))))

(ert-deftest overlook-courier-worktree-of-a-folder-of-repos ()
  (overlook-courier-test-with-tmp root
    (overlook-courier-test--repo (expand-file-name "api" root))
    (overlook-courier-test--repo (expand-file-name "web" root))
    (make-directory (expand-file-name "notes" root))
    (let ((path (overlook-worktree-add root "feature")))
      (should (file-exists-p (expand-file-name ".overlook" path)))
      (should (equal (mapcar (lambda (dir) (file-relative-name dir path)) (overlook-worktree-repos path))
                     '("api/" "web/")))
      (should (equal (overlook-courier-test--branch (expand-file-name "web" path)) "feature"))
      (write-region "x" nil (expand-file-name "api/dirty" path))
      (should-error (overlook-worktree-remove root "feature"))
      (overlook-worktree-remove root "feature" t)
      (should-not (file-exists-p path)))))

(ert-deftest overlook-courier-worktree-rolls-back-a-failed-folder ()
  (overlook-courier-test-with-tmp root
    (overlook-courier-test--repo (expand-file-name "api" root))
    (make-directory (expand-file-name "web/.git" root) t)
    (should-error (overlook-worktree-add root "feature"))
    (should-not (file-exists-p (overlook-worktree-path root "feature")))
    (should (equal (overlook-courier-test--branch (expand-file-name "api" root)) "main"))))

(ert-deftest overlook-courier-spawn-in-a-worktree ()
  (overlook-courier-test-with-tmp root
    (overlook-courier-test--repo root)
    (overlook-courier-test-with-agents '("a@p")
      (let* ((started nil)
             (overlook-courier-spawn-function
              (lambda (name directory parent _effort &optional as)
                (push directory started)
                (let ((id (or as (overlook-courier-new-id name directory))))
                  (overlook-courier-test--register id parent)
                  id)))
             (output (make-temp-file "overlook-courier-out")))
        (unwind-protect
            (let ((default-directory root))
              (should (overlook-courier-cli output (base64-encode-string "a@p")
                                   (base64-encode-string "spawn")
                                   (base64-encode-string "--worktree")
                                   (base64-encode-string "fix")
                                   (base64-encode-string "claude")
                                   (base64-encode-string ".")
                                   (base64-encode-string "go"))))
          (delete-file output))
        (should (equal started (list (expand-file-name ".worktrees/fix/" root))))
        (overlook-courier-deliver)
        (let ((brief (car (overlook-courier-test--received "claude@fix"))))
          (should (string-search "on branch fix" brief))
          (should (string-suffix-p "go" brief)))))))

(ert-deftest overlook-courier-hand-off-in-a-worktree ()
  (overlook-courier-test-with-tmp root
    (overlook-courier-test--repo root)
    (overlook-courier-test-with-agents '("a@p")
      (let ((overlook-courier-spawn-function
             (lambda (name directory parent _effort &optional as)
               (let ((id (or as (overlook-courier-new-id name directory))))
                 (overlook-courier-test--register id parent)
                 id))))
        (should (equal (overlook-courier-worktree-spawn "claude" root "fix" "go" "a@p" nil t) "claude@fix"))
        (should-not (overlook-courier-agent-parent (overlook-courier-agent "claude@fix")))
        (overlook-courier-deliver)
        (should-not (overlook-courier-test--received "claude@fix"))
        (let ((draft (car (alist-get "claude@fix" overlook-courier-test--drafts nil nil #'equal))))
          (should (string-search "on branch fix" draft))
          (should (string-suffix-p "go" draft)))))))

(ert-deftest overlook-courier-options-split-leading-options ()
  (should (equal (overlook-courier-options '("--effort" "low" "--worktree" "b" "x" "y")
                                  '("--effort" "--worktree"))
                 '((("--worktree" . "b") ("--effort" . "low")) "x" "y")))
  (should (equal (overlook-courier-options '("--handoff" "--effort" "low" "x") '("--effort") '("--handoff"))
                 '((("--effort" . "low") ("--handoff" . t)) "x")))
  (should-error (overlook-courier-options '("--effort") '("--effort"))))

(ert-deftest overlook-courier-gives-up-on-a-delivery-that-started-no-turn ()
  (overlook-courier-test-with-agents '("a@p")
    (progn
      (overlook-courier-send "a@p" "one")
      (overlook-courier-deliver)
      (overlook-courier-send "a@p" "two")
      (overlook-courier-deliver)
      (should (= (length (overlook-courier-test--received "a@p")) 1))
      (setf (overlook-courier-agent-delivered (overlook-courier-agent "a@p")) 100)
      (overlook-courier-deliver)
      (should (string-suffix-p "two" (cadr (overlook-courier-test--received "a@p")))))))

