;;; overlook-agent-resume-test.el --- Continuation appointments -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'overlook-agent-resume)
(require 'overlook-agent-shell)

(ert-deftest overlook-resume-selects-blocking-windows ()
  (let ((rows '(("claude @home" ("5h" 100 200) ("7d" 100 900))
                ("claude" ("5h" 10 300) ("7d" 30 800)))))
    (cl-letf (((symbol-function 'overlook-usage-claude) (lambda () rows))
              ((symbol-function 'overlook-usage-codex) #'ignore))
      (should (= 900 (overlook-usage-next-reset "claude @home" 100)))
      (should (= 300 (overlook-usage-next-reset "claude" 100)))
      (should-not (overlook-usage-next-reset "unknown" 100))
      (setf (nth 2 (cadr (car rows))) nil)
      (should-not (overlook-usage-next-reset "claude @home" 100)))))

(ert-deftest overlook-resume-uses-session-account ()
  (with-temp-buffer
    (let ((overlook-agent-shell--origin '("claude" . "/tmp/"))
          (overlook-agent-shell-claude-accounts '(("work") ("home")))
          (overlook-agent-shell-claude-account "work")
          (overlook-agent-shell--claude-account "home"))
      (should (equal "claude @home" (overlook-agent-shell--usage-row))))
    (let ((overlook-agent-shell--origin '("codex" . "/tmp/"))
          (overlook-agent-shell--codex-login "home"))
      (cl-letf (((symbol-function 'overlook-usage-codex-login) (lambda () "work")))
        (should-not (overlook-agent-shell--usage-row)))
      (cl-letf (((symbol-function 'overlook-usage-codex-login) (lambda () "home")))
        (should (equal "codex" (overlook-agent-shell--usage-row)))))))

(defmacro overlook-resume-test--agent (&rest body)
  "Run BODY with a session, clock and isolated appointment state."
  (declare (indent 0) (debug t))
  `(let ((overlook-agent-resume--jobs nil)
         (overlook-agent-resume--timer nil)
         (overlook-agent-resume--awake nil)
         (overlook-agent-resume-delay 300)
         (session "original") (row "claude @home") (ready t)
         (now 100.0) (sent nil) (starts t))
     (cl-letf (((symbol-function 'overlook-agent-resume--sync) #'ignore)
               ((symbol-function 'overlook-agent-changed) #'ignore)
               ((symbol-function 'float-time) (lambda (&optional _) now))
               ((symbol-function 'overlook-usage-next-reset)
                (lambda (name &optional _) (should (equal row name)) 200.0)))
       (with-temp-buffer
         (setq overlook-agent-identity
               `((agent . "claude")
                 (session . ,(lambda () session))
                 (usage-row . ,(lambda () row))
                 (ready . ,(lambda () ready))
                 (submit . ,(lambda (text)
                              (push text sent)
                              (when starts (overlook-agent-resume--started))))))
         ,@body))))

(ert-deftest overlook-resume-waits-five-minutes-sends-once-and-releases ()
  (overlook-resume-test--agent
    (overlook-agent-resume-toggle (current-buffer))
    (should (= 500 (plist-get (cdar overlook-agent-resume--jobs) :at)))
    (setq now 499.0)
    (overlook-agent-resume--tick)
    (should-not sent)
    (setq now 500.0)
    (overlook-agent-resume--tick)
    (overlook-agent-resume--tick)
    (should (equal sent '("continue")))
    (should (eq 'running (plist-get (cdar overlook-agent-resume--jobs) :phase)))
    (overlook-agent-resume--ended)
    (should-not overlook-agent-resume--jobs)))

(ert-deftest overlook-resume-cancels-on-manual-start-session-change-and-draft ()
  (overlook-resume-test--agent
    (overlook-agent-resume-toggle (current-buffer))
    (overlook-agent-resume--started)
    (should-not overlook-agent-resume--jobs)
    (overlook-agent-resume-toggle (current-buffer))
    (setq session "new")
    (overlook-agent-resume--tick)
    (should-not overlook-agent-resume--jobs)
    (overlook-agent-resume-toggle (current-buffer))
    (setq now 500.0 ready nil)
    (overlook-agent-resume--tick)
    (should-not overlook-agent-resume--jobs)
    (should-not sent)))

(ert-deftest overlook-resume-cleans-up-failed-submission-and-killed-buffer ()
  (overlook-resume-test--agent
    (overlook-agent-resume-toggle (current-buffer))
    (setf (alist-get 'submit overlook-agent-identity) (lambda (_) (error "Disconnected")))
    (setq now 500.0)
    (overlook-agent-resume--tick)
    (should-not overlook-agent-resume--jobs)
    (overlook-agent-resume-toggle (current-buffer))
    (overlook-agent-resume--killed)
    (should-not overlook-agent-resume--jobs)))

(ert-deftest overlook-resume-times-out-without-a-turn-start ()
  (overlook-resume-test--agent
    (overlook-agent-resume-toggle (current-buffer))
    (setq starts nil now 500.0)
    (overlook-agent-resume--tick)
    (setq now 621.0)
    (overlook-agent-resume--tick)
    (should (equal sent '("continue")))
    (should-not overlook-agent-resume--jobs)))

(ert-deftest overlook-resume-shares-and-releases-caffeinate ()
  (let ((system-type 'darwin)
        (overlook-agent-resume--jobs '((one) (two)))
        (overlook-agent-resume--timer nil)
        (overlook-agent-resume--awake nil)
        (made 0) (killed 0) (live nil))
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args)
                 (should (equal (plist-get args :command)
                                (list "/usr/bin/caffeinate" "-i" "-w"
                                      (number-to-string (emacs-pid)))))
                 (cl-incf made) (setq live t) 'awake))
              ((symbol-function 'process-live-p) (lambda (process) (and process live)))
              ((symbol-function 'delete-process) (lambda (_) (cl-incf killed) (setq live nil))))
      (unwind-protect
          (progn
            (overlook-agent-resume--sync)
            (overlook-agent-resume--sync)
            (setq overlook-agent-resume--jobs '((two)))
            (overlook-agent-resume--sync)
            (should (= made 1))
            (should (= killed 0))
            (setq overlook-agent-resume--jobs nil)
            (overlook-agent-resume--sync)
            (should (= killed 1))
            (should-not overlook-agent-resume--timer))
        (when (timerp overlook-agent-resume--timer)
          (cancel-timer overlook-agent-resume--timer))))))

(provide 'overlook-agent-resume-test)
;;; overlook-agent-resume-test.el ends here
