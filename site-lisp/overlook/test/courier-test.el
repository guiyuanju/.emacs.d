      (should (equal (plist-get persona :body) "You review code; you never edit it."))
      (should (equal (courier-persona-directory persona) (file-name-as-directory root)))
      (let ((briefing (courier-persona-briefing persona "codex")))
        (should (string-search "You are reviewer, a persona" briefing))
        (should (string-search "You review code" briefing))
        (should (string-search "Personality: exacting" briefing))
