;;; Personas

(defmacro courier-test-with-personas (ids &rest body)
  "Run BODY with fake agents IDS, a persona reviewer, and rooms, all fresh."
  (declare (indent 1))
  `(let* ((root (make-temp-file "courier-personas" t))
          (courier-persona-directories (list (expand-file-name "personas/" root)))
          (courier-room-directory (expand-file-name "rooms/" root))
          (courier-room--rooms nil)
          (courier-room--loaded nil)
          (courier-test--spawned nil)
          (courier-spawn-function
           (lambda (name directory parent effort &optional as)
             (push (list name directory parent effort as) courier-test--spawned)
             (let ((id (or as (courier-new-id name directory))))
               (courier-test--register id parent)
               id))))
     (make-directory (expand-file-name "personas/reviewer/memory" root) t)
     (with-temp-file (expand-file-name "personas/reviewer/persona.md" root)
       (insert "---\nengine: codex\neffort: high\ndescription: Reviews diffs\n"
               "avatar: 🦉\npersonality: exacting\ntone:\n---\nYou review code; you never edit it.\n"))
     (with-temp-file (expand-file-name "personas/reviewer/memory/MEMORY.md" root)
       (insert "- [Short reports](short.md) — the user wants findings only\n"))
     (unwind-protect
         (courier-test-with-agents ,ids ,@body)
       (delete-directory root t))))

(defvar courier-test--spawned nil
  "Arguments of each call to the fake spawn function, newest first.")

