;;; courier-test.el --- Tests for courier -*- lexical-binding: t; -*-

(require 'ert)
(require 'courier)
(require 'courier-room)
(require 'courier-persona)
(require 'courier-worktree)
(require 'courier-event)
(require 'courier-ci)

(defvar courier-test--inbox nil
  "Alist of agent id to the prompts delivered to it, newest first.")

(defvar courier-test--busy nil
  "Ids of the fake agents not ready for a prompt.")

(defvar courier-test--replies nil
  "Alist of agent id to its last reply.")

(defmacro courier-test-with-agents (ids &rest body)
  "Run BODY with fresh fake agents IDS registered."
  (declare (indent 1))
  `(let ((courier--agents (make-hash-table :test #'equal))
         (courier--retry-timer nil)
         (courier--delivery-timer nil)
         (courier-test--inbox nil)
         (courier-test--busy nil)
         (courier-test--replies nil))
     (unwind-protect
         (progn
           (mapc #'courier-test--register ,ids)
           ,@body)
       (when (timerp courier--retry-timer) (cancel-timer courier--retry-timer))
       (when (timerp courier--delivery-timer) (cancel-timer courier--delivery-timer)))))

(defun courier-test--register (id &optional parent)
  "Register fake agent ID, spawned by PARENT."
  (courier-register id
                    :parent parent
                    :deliver (lambda (text) (push text (alist-get id courier-test--inbox nil nil #'equal)))
                    :ready (lambda () (not (member id courier-test--busy)))
                    :reply (lambda () (alist-get id courier-test--replies nil nil #'equal))))

(defun courier-test--received (id)
  "Prompts delivered to ID, oldest first."
  (reverse (alist-get id courier-test--inbox nil nil #'equal)))

(ert-deftest courier-send-waits-until-the-agent-is-ready ()
  (courier-test-with-agents '("a@p" "b@p")
    (push "b@p" courier-test--busy)
    (courier-send "b@p" "one" "a@p")
    (courier-send "b@p" "two" "a@p")
    (courier-deliver)
    (should-not (courier-test--received "b@p"))
    (should (timerp courier--retry-timer))
    (setq courier-test--busy nil)
    (courier-deliver)
    (let ((prompts (courier-test--received "b@p")))
      (should (= (length prompts) 1))
      (should (string-match-p "From agent a@p.*courier send a@p" (car prompts)))
      (should (string-match-p "one\\(.\\|\n\\)*two" (car prompts))))
    (should-not courier--retry-timer)))

(ert-deftest courier-delivers-once-per-turn ()
  (courier-test-with-agents '("a@p" "b@p")
    (courier-send "b@p" "one" "a@p")
    (courier-deliver)
    (courier-send "b@p" "two" "a@p")
    (courier-deliver)
    (should (= (length (courier-test--received "b@p")) 1))
    (courier-turn-started "b@p")
    (courier-turn-finished "b@p")
    (courier-deliver)
    (should (= (length (courier-test--received "b@p")) 2))))

(ert-deftest courier-send-to-unknown-agent-errors ()
  (courier-test-with-agents '("a@p")
    (should-error (courier-send "nobody@p" "hi" "a@p") :type 'user-error)))

(ert-deftest courier-monitor-tells-once-with-the-reply ()
  (courier-test-with-agents '("a@p" "b@p")
    (courier-monitor "a@p" "b@p")
    (setf (alist-get "b@p" courier-test--replies nil nil #'equal) "all done")
    (courier-turn-finished "b@p")
    (courier-deliver)
    (should (string-match-p "b@p finished its turn.*\n\nall done"
                            (car (courier-test--received "a@p"))))
    (courier-turn-started "a@p")
    (courier-turn-finished "a@p")
    (courier-turn-finished "b@p")
    (courier-deliver)
    (should (= (length (courier-test--received "a@p")) 1))))

(ert-deftest courier-monitor-hears-when-the-agent-is-gone ()
  (courier-test-with-agents '("a@p")
    (let ((buffer (generate-new-buffer "b")))
      (courier-register "b@p" :buffer buffer :deliver #'ignore)
      (courier-monitor "a@p" "b@p")
      (kill-buffer buffer)
      (should-not (courier-agent "b@p"))
      (courier-deliver)
      (should (string-match-p "b@p is gone" (car (courier-test--received "a@p")))))))

(ert-deftest courier-spawn-briefs-the-child-and-reports-back ()
  (courier-test-with-agents '("a@p")
    (let* ((efforts nil)
           (courier-spawn-function
            (lambda (name directory parent effort &optional as)
              (push effort efforts)
              (let ((id (or as (courier-new-id name directory))))
                (courier-test--register id parent)
                id))))
      (should (equal (courier-spawn "codex" "/work/p/" "review foo.go" "a@p" "high") "codex@p"))
      (should (equal efforts '("high")))
      (courier-deliver)
      (let ((brief (car (courier-test--received "codex@p"))))
        (should (string-match-p "You are codex@p" brief))
        (should (string-match-p "a@p started you" brief))
        (should (string-suffix-p "review foo.go" brief)))
      (should (equal (courier-agent-parent (courier-agent "codex@p")) "a@p"))
      (courier-turn-started "codex@p")
      (setf (alist-get "codex@p" courier-test--replies nil nil #'equal) "looks fine")
      (courier-turn-finished "codex@p")
      (courier-deliver)
      (should (string-match-p "looks fine" (car (courier-test--received "a@p")))))))

(ert-deftest courier-new-id-stays-unique ()
  (courier-test-with-agents '("claude@shop")
    (should (equal (courier-new-id "claude" "/x/shop/") "claude@shop-2"))
    (should (equal (courier-new-id "codex" "/x/shop") "codex@shop"))))

(ert-deftest courier-drops-messages-past-max-hops ()
  (courier-test-with-agents '("a@p" "b@p")
    (let ((courier-max-hops 3)
          (inhibit-message t))
      ;; Two agents answering each other forever.
      (courier-send "b@p" "ping" "a@p")
      (dotimes (_ 10)
        (courier-deliver)
        (dolist (pair '(("a@p" . "b@p") ("b@p" . "a@p")))
          (when (courier-agent-delivered (courier-agent (car pair)))
            (courier-turn-started (car pair))
            (courier-send (cdr pair) "again" (car pair))
            (courier-turn-finished (car pair)))))
      (should (= (+ (length (courier-test--received "a@p"))
                    (length (courier-test--received "b@p")))
                 courier-max-hops)))))

(ert-deftest courier-human-turn-restarts-the-hops ()
  (courier-test-with-agents '("a@p" "b@p")
    (courier-send "b@p" "hi" "a@p")
    (courier-deliver)
    (courier-turn-started "b@p")
    (should (= (courier-agent-hops (courier-agent "b@p")) 1))
    (courier-turn-finished "b@p")
    (courier-turn-started "b@p")
    (should (= (courier-agent-hops (courier-agent "b@p")) 0))))

(ert-deftest courier-cli-decodes-arguments-and-writes-output ()
  (courier-test-with-agents '("a@p" "b@p")
    (let ((output (make-temp-file "courier-out"))
          (encode (lambda (s) (base64-encode-string (encode-coding-string s 'utf-8) t))))
      (unwind-protect
          (progn
            (should (courier-cli output (funcall encode "a@p") (funcall encode "send")
                                 (funcall encode "b@p") (funcall encode "看一下 \"x\"\n")))
            (courier-deliver)
            (should (string-match-p "看一下 \"x\"" (car (courier-test--received "b@p"))))
            (should-not (courier-cli output (funcall encode "a@p") (funcall encode "send")
                                     (funcall encode "zz@p") (funcall encode "hi")))
            (should (string-prefix-p "error: No agent zz@p"
                                     (with-temp-buffer (insert-file-contents output)
                                                       (buffer-string))))
            (courier-cli output "" (funcall encode "whoami"))
            (should (string-prefix-p "Not a courier agent"
                                     (with-temp-buffer (insert-file-contents output)
                                                       (buffer-string)))))
        (delete-file output)))))

(defmacro courier-test-with-child (&rest body)
  "Run BODY with agent a@p and its child c@p, which got a task from it."
  (declare (indent 0))
  `(courier-test-with-agents '("a@p")
     (courier-test--register "c@p" "a@p")
     (courier-send "c@p" "the task" "a@p")
     (courier-deliver)
     (courier-turn-started "c@p")
     (setf (alist-get "c@p" courier-test--replies nil nil #'equal) "my reply")
     ,@body))

(ert-deftest courier-child-report-replaces-its-reply ()
  (courier-test-with-child
    (courier-send "a@p" "found two bugs" "c@p")
    (courier-turn-finished "c@p")
    (courier-deliver)
    (let ((prompts (courier-test--received "a@p")))
      (should (= (length prompts) 1))
      (should (string-match-p "From agent c@p, not from your user" (car prompts)))
      (should (string-suffix-p "found two bugs" (car prompts))))))

(ert-deftest courier-child-that-does-not-report-sends-its-reply ()
  (courier-test-with-child
    (courier-turn-finished "c@p")
    (courier-deliver)
    (should (string-match-p "c@p finished its turn.*\n\nmy reply"
                            (car (courier-test--received "a@p"))))
    ;; A turn the user started is not the parent's business.
    (courier-turn-started "a@p")
    (courier-turn-finished "a@p")
    (courier-turn-started "c@p")
    (courier-turn-finished "c@p")
    (courier-deliver)
    (should (= (length (courier-test--received "a@p")) 1))))

(ert-deftest courier-child-error-reaches-the-parent-even-after-a-report ()
  (courier-test-with-child
    (courier-send "a@p" "half done" "c@p")
    (courier-turn-finished "c@p" "Overloaded")
    (courier-deliver)
    (should (string-match-p "half done\\(.\\|\n\\)*c@p hit an error: Overloaded"
                            (car (courier-test--received "a@p"))))))

(ert-deftest courier-child-waiting-for-the-user-tells-the-parent-once-a-turn ()
  (courier-test-with-child
    (courier-blocked "c@p" "⚠ Bash rm -rf build")
    (courier-blocked "c@p" "⚠ Bash rm -rf dist")
    (courier-send "a@p" "done" "c@p")
    (courier-turn-finished "c@p")
    (courier-deliver)
    (let ((prompt (car (courier-test--received "a@p"))))
      (should (string-match-p "c@p is waiting for the user: ⚠ Bash rm -rf build" prompt))
      (should-not (string-match-p "dist" prompt)))
    (courier-turn-started "a@p")
    (courier-turn-finished "a@p")
    (courier-turn-started "c@p")
    (courier-blocked "c@p" "? Which branch")
    (courier-deliver)
    ;; Only the user can answer, so the parent is not woken for it.
    (should (= (length (courier-test--received "a@p")) 1))
    (courier-send "a@p" "next" "c@p")
    (courier-deliver)
    (should (string-match-p "Which branch\\(.\\|\n\\)*next" (cadr (courier-test--received "a@p"))))))

(ert-deftest courier-parent-hears-when-its-child-is-gone ()
  (courier-test-with-agents '("a@p")
    (let ((buffer (generate-new-buffer "c")))
      (courier-register "c@p" :buffer buffer :deliver #'ignore :parent "a@p")
      (kill-buffer buffer)
      (courier-deliver)
      ;; It owed no report, so the parent learns of it with its next prompt.
      (should-not (courier-test--received "a@p"))
      (courier-send "a@p" "hi")
      (courier-deliver)
      (should (string-match-p "c@p is gone\\(.\\|\n\\)*hi" (car (courier-test--received "a@p")))))))

(ert-deftest courier-child-gone-before-reporting-wakes-the-parent ()
  (courier-test-with-agents '("a@p")
    (let ((buffer (generate-new-buffer "c")))
      (courier-register "c@p" :buffer buffer :deliver #'ignore :parent "a@p")
      (courier-send "c@p" "the task" "a@p")
      (courier-deliver)
      (kill-buffer buffer)
      (courier-deliver)
      (should (string-match-p "c@p is gone" (car (courier-test--received "a@p")))))))

(ert-deftest courier-cuts-a-long-reply-from-its-start ()
  (courier-test-with-child
    (let ((courier-reply-max 10))
      (setf (alist-get "c@p" courier-test--replies nil nil #'equal) "0123456789abcdefghij")
      (courier-turn-finished "c@p")
      (courier-deliver)
      (should (string-match-p "\\[… 10 characters cut\\]\nabcdefghij\\'"
                              (car (courier-test--received "a@p")))))))

(ert-deftest courier-spawn-without-a-prompt-waits-to-brief ()
  (courier-test-with-agents '("a@p")
    (let ((courier-spawn-function
           (lambda (name directory parent _effort &optional _as)
             (let ((id (courier-new-id name directory)))
               (courier-test--register id parent)
               id))))
      (courier-spawn "codex" "/work/p/" nil "a@p")
      (courier-deliver)
      (should-not (courier-test--received "codex@p"))
      (courier-send "codex@p" "now this" "a@p")
      (courier-deliver)
      (should (string-match-p "You are codex@p\\(.\\|\n\\)*now this"
                              (car (courier-test--received "codex@p")))))))

(ert-deftest courier-gathers-mail-before-delivering ()
  (courier-test-with-agents '("a@p" "b@p")
    (let ((courier-delivery-delay 0.05))
      (courier-send "b@p" "one" "a@p")
      (courier-send "b@p" "two" "a@p")
      (should-not (courier-test--received "b@p"))
      (sleep-for 0.2)
      (should (= (length (courier-test--received "b@p")) 1)))))

(defmacro courier-test-with-rooms (ids &rest body)
  "Run BODY with fake agents IDS and no rooms, kept in a fresh directory."
  (declare (indent 1))
  `(let ((courier-room-directory (make-temp-file "courier-rooms" t))
         (courier-room--rooms nil)
         (courier-room--loaded nil)
         (courier-room-post-functions nil)
         (courier-room-close-functions nil))
     (unwind-protect
         (courier-test-with-agents ,ids ,@body)
       (delete-directory courier-room-directory t))))

(ert-deftest courier-room-mentions-match-whole-ids ()
  (should (courier-room-mentions-p "@a@p." "a@p"))
  (should (courier-room-mentions-p "cc @a@p, please" "a@p"))
  (should (courier-room-mentions-p "@all look" "a@p"))
  (should-not (courier-room-mentions-p "@a@p-2 look" "a@p"))
  (should-not (courier-room-mentions-p "mail a@p" "a@p")))

(ert-deftest courier-room-post-wakes-only-who-it-is-for ()
  (courier-test-with-rooms '("a@p" "b@p" "c@p" "d@p")
    (courier-room-join "design" "b@p")
    (courier-room-join "#design" "c@p" 'all)
    (courier-room-join "design" "d@p" 'none)
    (courier-room-post "design" "a@p" "plain talk")
    (courier-room-post "design" "a@p" "@b@p your turn")
    (courier-deliver)
    (should-not (courier-test--received "a@p"))
    (should (string-match-p "#design, from agent a@p, not from your user\\(.\\|\n\\)*your turn"
                            (car (courier-test--received "b@p"))))
    (should (string-match-p "Unread in #design before the post for you:\n.*a@p: plain talk\n\n"
                            (car (courier-test--received "b@p"))))
    (should (string-match-p "plain talk\\(.\\|\n\\)*your turn" (car (courier-test--received "c@p"))))
    (should-not (courier-test--received "d@p"))
    (courier-room-post "design" courier-room-user "@all stop")
    (courier-turn-started "b@p")
    (courier-turn-finished "b@p")
    (courier-deliver)
    (should (string-match-p "from your user" (cadr (courier-test--received "b@p"))))
    (should-not (courier-test--received "d@p"))))

(ert-deftest courier-room-read-returns-the-unread-and-notes-them-in-prompts ()
  (courier-test-with-rooms '("a@p" "b@p")
    (courier-room-join "ops" "b@p")
    (courier-room-post "ops" "a@p" "one")
    (courier-room-post "ops" "a@p" "two\nlines")
    (courier-send "b@p" "hi" "a@p")
    (courier-deliver)
    (should (string-match-p "Unread in rooms: #ops 2" (car (courier-test--received "b@p"))))
    (should (string-match-p "a@p: one\n.*a@p: two\n    lines" (courier-room-read "ops" "b@p")))
    (should (equal (courier-room-read "ops" "b@p") "No unread posts in #ops."))
    (should (string-match-p "two" (courier-room-read "ops" "b@p" 1)))
    (should-not (courier-room-note "b@p"))))

(ert-deftest courier-room-outlives-emacs ()
  (courier-test-with-rooms '("a@p" "b@p")
    (courier-room-join "ops" "b@p" 'all)
    (courier-room-post "ops" "a@p" "kept")
    (setq courier-room--rooms nil courier-room--loaded nil)
    (should (equal (courier-room-names) '("ops")))
    (let ((room (courier-room "ops")))
      (should (= (courier-room-count room) 1))
      (should (eq (plist-get (courier-room-member room "b@p") :wake) 'all))
      (should (equal (plist-get (car (courier-room-history "ops")) :body) "kept")))))

(ert-deftest courier-room-cli-posts-reads-and-lists ()
  (courier-test-with-rooms '("a@p" "b@p")
    (should (string-match-p "Joined #x" (courier-room-cli "b@p" '("join" "x"))))
    (should (equal (courier-room-cli "a@p" '("post" "#x" "hello @b@p")) "Posted #1 in #x."))
    (should (string-match-p "#x  1 posts  members: b@p, a@p"
                            (courier-room-cli "b@p" '("list"))))
    (should (string-match-p "No unread" (courier-room-cli "b@p" '("read" "x"))))
    (should (string-match-p "hello" (courier-room-cli "b@p" '("read" "x" "--last" "1"))))
    (should-error (courier-room-cli "a@p" '("post" "Bad Name" "x")) :type 'user-error)))

(ert-deftest courier-room-invite-adds-and-tells-the-agent ()
  (courier-test-with-rooms '("a@p" "b@p")
    (courier-room-post "ops" "a@p" "context")
    (should (equal (courier-room-cli "a@p" '("invite" "ops" "b@p")) "Added b@p to #ops."))
    (courier-room-invite "ops" "b@p" courier-room-user)
    (courier-deliver)
    (let ((prompt (car (courier-test--received "b@p"))))
      (should (string-match-p "Agent a@p added you to the chat room #ops" prompt))
      (should (string-match-p "Your user added you" prompt))
      (should (string-match-p "a@p: context" prompt)))
    (should (courier-room-member (courier-room "ops") "b@p"))
    (should-error (courier-room-invite "ops" "nobody@p") :type 'user-error)))

(ert-deftest courier-room-naming-an-agent-adds-it ()
  (courier-test-with-rooms '("a@p" "b@p" "c@p")
    (courier-room-post "ops" "a@p" "@all hello")
    (should-not (courier-room-member (courier-room "ops") "b@p"))
    (courier-room-post "ops" "a@p" "@b@p please look")
    (courier-deliver)
    (should (courier-room-member (courier-room "ops") "b@p"))
    (should-not (courier-room-member (courier-room "ops") "c@p"))
    (let ((prompt (car (courier-test--received "b@p"))))
      (should (string-match-p "please look\n\n\\[courier\\] Being named added you to #ops" prompt)))
    (should (= (courier-room-unread (courier-room "ops") "b@p") 0))))

(ert-deftest courier-room-spawn-starts-a-member ()
  (courier-test-with-rooms '("a@p")
    (let* ((spawned nil)
           (courier-spawn-function
            (lambda (name directory parent effort &optional as)
              (push (list name parent effort) spawned)
              (let ((id (or as (courier-new-id name directory))))
                (courier-test--register id parent)
                id))))
      (should (equal (courier-room-spawn "ops" "codex" "/work/p/" courier-room-user "low") "codex@p"))
      (should (equal spawned '(("codex" nil "low"))))
      (should (courier-room-member (courier-room "ops") "codex@p"))
      (courier-deliver)
      (should-not (courier-test--received "codex@p"))
      (courier-room-post "ops" courier-room-user "@codex@p hello")
      (courier-deliver)
      (should (string-match-p "Your user added you to the chat room #ops\\(.\\|\n\\)*hello"
                              (car (courier-test--received "codex@p"))))
      (courier-room-post "ops" "a@p" "@codex@p fine")
      (courier-turn-started "codex@p")
      (courier-turn-finished "codex@p")
      (courier-deliver)
      ;; A room post asks for no report, so the spawning agent hears nothing.
      (should-not (courier-test--received "a@p"))
      (courier-room-spawn "ops" "claude" "/work/p/" "a@p" nil "Draft it")
      (should (equal (car spawned) '("claude" "a@p" nil)))
      (courier-deliver)
      (should (string-suffix-p "Draft it" (car (courier-test--received "claude@p")))))))

(ert-deftest courier-room-close-archives-the-posts ()
  (courier-test-with-rooms '("a@p")
    (let ((closed nil))
      (add-hook 'courier-room-close-functions (lambda (name) (push name closed)))
      (courier-room-post "ops" "a@p" "kept")
      (should (string-match-p "Closed #ops" (courier-room-cli "a@p" '("close" "ops"))))
      (should (equal closed '("ops")))
      (should-not (courier-room-names))
      (setq courier-room--rooms nil courier-room--loaded nil)
      (should-not (courier-room-names))
      (let ((archived (directory-files (expand-file-name "archive" courier-room-directory) t "\\`ops-")))
        (should (= (length archived) 1))
        (should (string-match-p "kept" (with-temp-buffer (insert-file-contents (car archived))
                                                        (buffer-string))))))))

(ert-deftest courier-room-note-leaves-out-the-posts-that-woke-the-member ()
  (courier-test-with-rooms '("a@p" "b@p")
    (courier-room-join "ops" "b@p")
    (courier-room-post "ops" "a@p" "@b@p look")
    (courier-room-post "ops" "b@p" "mine")
    (should-not (courier-room-note "b@p"))
    (courier-room-post "ops" "a@p" "aside")
