;;; overlook-remote-service-test.el --- Application operation regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'overlook-remote-service)

(defmacro overlook-service-test-with-agent (&rest body)
  "Run BODY with a fake live agent named BUFFER."
  (declare (indent 0))
  `(let ((buffer (generate-new-buffer "service-agent")))
     (unwind-protect
         (progn
           (with-current-buffer buffer
             (setq overlook-agent-identity '((agent . "test"))))
           ,@body)
       (kill-buffer buffer))))

(ert-deftest overlook-service-identity-survives-rename-and-not-replacement ()
  (overlook-service-test-with-agent
    (let ((id (overlook-remote-service-agent-id buffer))
          (name (buffer-name buffer)))
      (with-current-buffer buffer (rename-buffer "renamed-service-agent" t))
      (should (equal id (overlook-remote-service-agent-id buffer)))
      (should (eq buffer (overlook-remote-service-agent-buffer id)))
      (kill-buffer buffer)
      (setq buffer (generate-new-buffer name))
      (with-current-buffer buffer (setq overlook-agent-identity '((agent . "test"))))
      (should-not (equal id (overlook-remote-service-agent-id buffer)))
      (should-error (overlook-remote-service-agent-buffer id)
                    :type 'overlook-remote-missing-agent))))

(ert-deftest overlook-service-queue-ids-distinguish-identical-prompts ()
  (overlook-service-test-with-agent
    (with-current-buffer buffer
      (setq overlook-remote--queue (mapcar #'overlook-remote--queue-entry '("same" "same"))))
    (cl-letf (((symbol-function 'overlook-remote--wake) #'ignore))
      (let* ((items (with-current-buffer buffer (copy-sequence overlook-remote--queue)))
             (first (plist-get (car items) :id))
             (second (plist-get (cadr items) :id)))
        (should-not (equal first second))
        (overlook-remote--unqueue buffer nil second)
        (should (equal (with-current-buffer buffer overlook-remote--queue) (list (car items))))
        (should-error (overlook-remote--unqueue buffer nil second))
        (should (equal (mapcar (lambda (item) (plist-get item :text))
                               (buffer-local-value 'overlook-remote--queue buffer)) '("same")))))))

(ert-deftest overlook-service-idempotency-replays-and-detects-payload-changes ()
  (let ((overlook-remote-service--receipts (make-hash-table :test #'equal))
        (calls 0)
        (body '((requestId . "request") (id . "target") (text . "hello"))))
    (let ((send (lambda (_) (cl-incf calls) '(:ok t :queued :false))))
      (should (equal (overlook-remote-service-once "/prompt" body send) '(:ok t :queued :false)))
      (overlook-remote-service-once "/prompt" (reverse body) send)
      (should (= calls 1))
      (should-error (overlook-remote-service-once "/session" body send))
      (should-error (overlook-remote-service-once "/prompt" (cons '(extra . "changed") body) send)))))

(ert-deftest overlook-service-receipts-expire-and-remain-bounded ()
  (let ((overlook-remote-service--receipts (make-hash-table :test #'equal))
        (overlook-remote-receipt-limit 2)
        (overlook-remote-receipt-seconds 10)
        (now 100))
    (cl-letf (((symbol-function 'float-time) (lambda (&rest _) now)))
      (dotimes (i 3)
        (overlook-remote-service-once "/prompt" `((requestId . ,(number-to-string i)))
                                      (lambda (_) '(:ok t)))
        (cl-incf now))
      (should (= 2 (hash-table-count overlook-remote-service--receipts)))
      (should-not (gethash "0" overlook-remote-service--receipts))
      (setq now 120)
      (overlook-remote-service--prune-receipts)
      (should (= 0 (hash-table-count overlook-remote-service--receipts))))))

(ert-deftest overlook-service-confirmations-are-not-idempotency-receipts ()
  (let ((overlook-remote-service--receipts (make-hash-table :test #'equal))
        (calls 0))
    (dotimes (_ 2)
      (overlook-remote-service-once "/session" '((requestId . "same"))
                                    (lambda (_) (cl-incf calls) '(:confirm "Continue?"))))
    (should (= calls 2))
    (should (= 0 (hash-table-count overlook-remote-service--receipts)))))

(ert-deftest overlook-service-command-confirmation-binds-current-state ()
  (let* ((ran 0)
         (state "version-one")
         (dashboard "dashboard-one")
         (row (overlook-row :id 'task :content "Task"
                           :commands (list (list :name "delete" :confirm "Delete task?"
                                                 :run (lambda () (cl-incf ran))))))
         (overlook-remote--rows (make-hash-table :test #'equal))
         (body '((node . "task") (name . "delete"))))
    (puthash "task" row overlook-remote--rows)
    (cl-letf (((symbol-function 'overlook-remote--dashboard) (lambda () (cons [] dashboard)))
              ((symbol-function 'overlook-refresh) #'ignore)
              ((symbol-function 'overlook-remote--node) (lambda (&rest _) (list :status state))))
      (let* ((first (overlook-remote-service-command body))
             (confirmed (append `((confirmed . t)
                                  (confirmationToken . ,(plist-get first :confirmationToken))) body)))
        (should (plist-get first :confirm))
        (setq state "version-two")
        (should (plist-get (overlook-remote-service-command confirmed) :confirm))
        (should (= ran 0))
        (setq state "version-one" dashboard "unrelated-update")
        (should (plist-get (overlook-remote-service-command confirmed) :ok))
        (should (= ran 1))))))

(ert-deftest overlook-service-session-confirmations-bind-state-and-action ()
  (overlook-service-test-with-agent
    (let ((state "one") (ran 0))
      (with-current-buffer buffer
        (setf (alist-get 'remote-controls overlook-agent-identity)
              (lambda () '(:actions ("restart" "reload")))
              (alist-get 'remote-action overlook-agent-identity)
              (lambda (_action _text)
                (when (y-or-n-p "Busy. Continue?") (cl-incf ran)) buffer)))
      (cl-letf (((symbol-function 'overlook-remote--state) (lambda (_) (cons nil state))))
        (let* ((body `((id . ,(overlook-remote-service-agent-id buffer)) (action . "restart")))
               (first (overlook-remote-service-session body))
               (confirmed (append `((confirmations . [,(plist-get first :confirm)])
                                    (confirmationToken . ,(plist-get first :confirmationToken))) body))
               (second (overlook-remote-service-session confirmed)))
          (should (equal (plist-get second :confirm) "Busy. Continue?"))
          (should (= ran 0))
          (setf (alist-get 'confirmations confirmed)
                (vector (plist-get first :confirm) (plist-get second :confirm))
                (alist-get 'confirmationToken confirmed) (plist-get second :confirmationToken))
          (setq state "two")
          (should (equal (plist-get (overlook-remote-service-session confirmed) :confirm)
                         (plist-get first :confirm)))
          (should (= ran 0))
          (setq state "one")
          (let ((other (copy-tree confirmed)))
            (setf (alist-get 'action other) "reload")
            (should (plist-get (overlook-remote-service-session other) :confirm))
            (should (= ran 0)))
          (should (plist-get (overlook-remote-service-session confirmed) :ok))
          (should (= ran 1)))))))

(ert-deftest overlook-service-errors-have-actionable-status-and-code ()
  (let ((overlook-remote--rows (make-hash-table :test #'equal)))
    (cl-letf (((symbol-function 'overlook-remote--dashboard) (lambda () (cons [] "state"))))
      (let ((err (should-error (overlook-remote-service-command '((node . "gone") (name . "done")))
                               :type 'overlook-remote-api-error)))
        (should (= (nth 1 err) 404))
        (should (equal (nth 2 err) "resource_missing")))))
  (let ((err (should-error (overlook-remote-service-prompt '((text . "  ")))
                           :type 'overlook-remote-api-error)))
    (should (= (nth 1 err) 400))
    (should (equal (nth 2 err) "empty_text"))))

(ert-deftest overlook-service-evicted-history-reconnect-gets-full-snapshot ()
  (overlook-service-test-with-agent
    (let ((overlook-remote-history 2)
          (overlook-remote--seq 0))
      (cl-letf (((symbol-function 'overlook-remote--wake) #'ignore))
        (overlook-remote--record buffer '(:type prompt :text "one"))
        (overlook-remote--record buffer '(:type prompt :text "two"))
        (overlook-remote--record buffer '(:type prompt :text "three"))
        (should (= 1 (buffer-local-value 'overlook-remote--history-floor buffer)))
        (should (overlook-remote--reset-p 0 buffer))
        (should-not (overlook-remote--reset-p 1 buffer))
        (should (overlook-remote--news-p buffer 0 "unchanged"))
        (let ((news (overlook-remote--news-data buffer 0)))
          (should (eq t (plist-get news :reset)))
          (should (equal (mapcar (lambda (item) (plist-get item :text))
                                (append (plist-get news :items) nil)) '("two" "three"))))))))

(ert-deftest overlook-service-upload-validates-before-attachment ()
  (overlook-service-test-with-agent
    (let* ((attached nil)
           (bytes (unibyte-string 137 80 78 71 13 10 26 10))
           (body `((id . ,(overlook-remote-service-agent-id buffer))
                   (mime . "image/png") (data . ,(base64-encode-string bytes t)))))
      (let ((err (should-error (overlook-remote-service-upload body)
                               :type 'overlook-remote-api-error)))
        (should (= (nth 1 err) 409)))
      (with-current-buffer buffer
        (setf (alist-get 'attach overlook-agent-identity)
              (lambda (name data) (setq attached (list name data)) "@image.png")))
      (let ((bad (copy-tree body)))
        (setf (alist-get 'data bad) "invalid base64!")
        (should-error (overlook-remote-service-upload bad) :type 'overlook-remote-api-error)
        (should-not attached))
      (let ((overlook-remote-image-size 2))
        (let ((err (should-error (overlook-remote-service-upload body)
                                 :type 'overlook-remote-api-error)))
          (should (= (nth 1 err) 413))
          (should-not attached)))
      (should (equal (overlook-remote-service-upload body) '(:text "@image.png")))
      (should (string-suffix-p ".png" (car attached)))
      (should (equal bytes (cadr attached))))))

(provide 'overlook-remote-service-test)
;;; overlook-remote-service-test.el ends here

(ert-deftest overlook-service-confirmed-success-replays-without-confirmation-fields ()
  (dolist (route '("/api/session" "/api/command"))
    (let ((overlook-remote-service--receipts (make-hash-table :test #'equal))
          (calls 0)
          (body '((requestId . "retry") (id . "target") (action . "close"))))
      (let ((send (lambda (_) (cl-incf calls) '(:ok t :closed t))))
        (overlook-remote-service-once
         route (append '((confirmed . t) (confirmations . ["Close?"])
                         (confirmationToken . "proof")) body) send)
        (should (equal (overlook-remote-service-once
                        route (append '((confirmations . [])) body) send)
                       '(:ok t :closed t)))
        (should (= calls 1))
        (should-error (overlook-remote-service-once
                       route (cons '(text . "changed") body) send))))))

(ert-deftest overlook-service-running-agent-command-confirms-despite-clock ()
  (overlook-service-test-with-agent
    (let* ((now 100.0) (ran 0)
           (row (overlook-row :id (cons 'agent buffer) :content "Agent"
                             :commands (list (list :name "kill" :confirm "Kill?"
                                                   :run (lambda () (cl-incf ran))))))
           (overlook-remote--rows (make-hash-table :test #'equal))
           (body '((node . "target") (name . "kill"))))
      (with-current-buffer buffer
        (setq overlook-agent-turn '(90.0) overlook-agent-status 'working))
      (puthash "target" row overlook-remote--rows)
      (cl-letf (((symbol-function 'float-time) (lambda (&rest _) now))
                ((symbol-function 'overlook-remote--dashboard) #'ignore)
                ((symbol-function 'overlook-refresh) #'ignore))
        (let* ((first (overlook-remote-service-command body))
               (confirmed (append `((confirmed . t)
                                    (confirmationToken . ,(plist-get first :confirmationToken))) body)))
          (setq now 110.0)
          (should (plist-get (overlook-remote-service-command confirmed) :ok))
          (should (= ran 1))
          (with-current-buffer buffer (setq overlook-agent-status 'done))
          (should (plist-get (overlook-remote-service-command confirmed) :confirm))
          (should (= ran 1)))))))

(ert-deftest overlook-service-session-confirmation-recovers-after-state-change ()
  (overlook-service-test-with-agent
    (let ((state "one") (ran 0))
      (with-current-buffer buffer
        (setf (alist-get 'remote-controls overlook-agent-identity)
              (lambda () '(:actions ("restart")))
              (alist-get 'remote-action overlook-agent-identity)
              (lambda (&rest _)
                (when (y-or-n-p "Busy. Continue?") (cl-incf ran)) buffer)))
      (cl-letf (((symbol-function 'overlook-remote--state) (lambda (_) (cons nil state))))
        (let* ((body `((id . ,(overlook-remote-service-agent-id buffer)) (action . "restart")))
               (first (overlook-remote-service-session body)))
          (setq state "two")
          (dotimes (step 3)
            (setf (alist-get 'confirmations body) (plist-get first :confirmations)
                  (alist-get 'confirmationToken body) (plist-get first :confirmationToken))
            (setq first (overlook-remote-service-session body))
            (if (< step 2) (should (plist-get first :confirm))
              (should (plist-get first :ok))))
          (should (= ran 1)))))))
