{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:overlook:remote-api:2",
  "title": "Overlook Remote API protocol 2",
  "description": "Responses carry protocolVersion at the top level. Domain objects contain data and capabilities; visual presentation belongs to the client. Definitions also document request bodies.",
  "anyOf": [
    {
      "$ref": "#/$defs/Dashboard"
    },
    {
      "$ref": "#/$defs/Conversations"
    },
    {
      "$ref": "#/$defs/Conversation"
    },
    {
      "$ref": "#/$defs/Events"
    },
    {
      "$ref": "#/$defs/Problem"
    },
    {
      "$ref": "#/$defs/Result"
    },
    {
      "$ref": "#/$defs/History"
    }
  ],
  "$defs": {
    "UsageWindow": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "reset": {
          "type": [
            "number",
            "string",
            "null"
          ]
        }
      },
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "Choice": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirm": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": [
            "number",
            "null"
          ]
        },
        "duration": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "durationSeconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "resourceId": {
          "type": "string"
        },
        "account": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "added": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "removed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "due": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "repositoryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UsageWindow"
          }
        },
        "id": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeDelta"
          }
        },
        "heading": {
          "type": "boolean"
        },
        "attention": {
          "type": "boolean"
        },
        "agent": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "diff": {
          "type": "boolean"
        },
        "persona": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "unreadCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "hash",
        "kind",
        "title",
        "children"
      ],
      "additionalProperties": false
    },
    "NodeDelta": {
      "oneOf": [
        {
          "$ref": "#/$defs/Node"
        },
        {
          "type": "object",
          "properties": {
            "same": {
              "type": "string"
            }
          },
          "required": [
            "same"
          ],
          "additionalProperties": false
        }
      ]
    },
    "QueueItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "Controls": {
      "type": "object",
      "properties": {
        "slash": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "steer": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Conversation": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "id": {
          "type": "string"
        },
        "bufferName": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "idle",
            "working",
            "waiting",
            "done",
            "failed"
          ]
        },
        "title": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "folder": {
          "type": "string"
        },
        "brief": {
          "type": "string"
        },
        "context": {
          "type": [
            "number",
            "null"
          ]
        },
        "queueError": {
          "type": [
            "string",
            "null"
          ]
        },
        "reply": {
          "type": "string"
        },
        "transcript": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "queued": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queueItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueueItem"
          }
        },
        "controls": {
          "$ref": "#/$defs/Controls"
        },
        "persona": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "unreadCount": {
          "type": "integer",
          "minimum": 0
        },
        "readThrough": {
          "type": "integer",
          "minimum": 0
        },
        "latestSeq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "agent",
        "status",
        "title"
      ],
      "additionalProperties": false
    },
    "Dashboard": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeDelta"
          }
        },
        "known": {
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "sections",
        "known"
      ],
      "additionalProperties": false
    },
    "Conversations": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Conversation"
          }
        }
      },
      "required": [
        "protocolVersion",
        "agents"
      ],
      "additionalProperties": false
    },
    "ActivityItem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "item": {
          "type": "integer"
        },
        "seq": {
          "type": "integer"
        },
        "id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "images": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "item",
        "seq",
        "offset",
        "images"
      ],
      "additionalProperties": false
    },
    "Events": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "agent": {
          "$ref": "#/$defs/Conversation"
        },
        "known": {
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "epoch": {
          "type": "string"
        },
        "reset": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityItem"
          }
        },
        "history": {
          "type": "object",
          "properties": {
            "hasMore": {
              "type": "boolean"
            },
            "before": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "hasMore",
            "before"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "agent",
        "known",
        "seq",
        "epoch",
        "reset",
        "items"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "title",
        "status",
        "code",
        "detail"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "ok": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        },
        "queued": {
          "type": "boolean"
        },
        "agent": {
          "type": "string"
        },
        "draft": {
          "type": "string"
        },
        "confirm": {
          "type": "string"
        },
        "confirmations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confirmationToken": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        },
        "readThrough": {
          "type": "integer",
          "minimum": 0
        },
        "unreadCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "protocolVersion"
      ],
      "additionalProperties": false
    },
    "PromptRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "protocolVersion": {
          "const": 2
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "CommandRequest": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "option": {
          "type": "string"
        },
        "confirmed": {
          "type": "boolean"
        },
        "confirmationToken": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "protocolVersion": {
          "const": 2
        }
      },
      "required": [
        "node",
        "name"
      ],
      "additionalProperties": false
    },
    "UnqueueRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "queueId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "protocolVersion": {
          "const": 2
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "History": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 2
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivityItem"
          }
        },
        "hasMore": {
          "type": "boolean"
        },
        "before": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "items",
        "hasMore",
        "before",
        "epoch"
      ],
      "additionalProperties": false
    },
    "SeenRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "through": {
          "type": "integer",
          "minimum": 0
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "protocolVersion": {
          "const": 2
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
}
