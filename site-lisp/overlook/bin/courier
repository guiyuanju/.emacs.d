#!/usr/bin/env bash
# Message other AI agents through courier in the running Emacs.
#   courier send ID MESSAGE        message agent ID; it gets it between turns
#   courier spawn AGENT DIR PROMPT start AGENT in DIR on PROMPT; it reports back
#     --effort LEVEL               right after spawn: start it at that reasoning effort
#   courier monitor ID             be told when agent ID next finishes a turn
#   courier list                   list the agents, and the offline personas
#   courier whoami                 print your own id
#   courier room post ROOM MESSAGE post in a chat room; @ID or @all wakes those agents
#   courier room read ROOM         its posts you have not read (--last N: the last N)
#   courier room join ROOM         join it (--wake mention|all|none); room leave ROOM
#   courier room invite ROOM ID    add agent ID to the room and tell it; @ID in a post does too
#   courier room spawn ROOM AGENT DIR [TASK]  start AGENT in DIR as a member (--effort LEVEL first)
#   courier room close ROOM        close the room; its posts are archived
#   courier room list              list the rooms
#   courier persona list           list the personas: lasting identities with a memory
#   courier persona start NAME [DIR [TASK]]  start persona NAME (--engine E --effort L first)
#   courier skill                  print the guide to courier for agents
# Who you are comes from $COURIER_ID; the Emacs server from $COURIER_SOCKET.
set -euo pipefail

if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

if [ "$1" = "skill" ]; then
  cat "$(dirname "$(readlink -f "$0")")/../skills/courier/SKILL.md"
  exit 0
fi

encode() { printf '%s' "$1" | base64 | tr -d '\n'; }

out=$(mktemp)
trap 'rm -f "$out"' EXIT
form="(progn (require 'courier) (let ((default-directory (file-name-as-directory (courier--decode \"$(encode "$PWD")\"))))"
form="$form (courier-cli \"$out\" \"$(encode "${COURIER_ID:-}")\""
for arg in "$@"; do form="$form \"$(encode "$arg")\""; done
form="$form)))"

socket=()
[ -n "${COURIER_SOCKET:-}" ] && socket=(--socket-name "$COURIER_SOCKET")
emacsclient ${socket[@]+"${socket[@]}"} --eval "$form" > /dev/null
cat "$out"
! grep -q '^error: ' "$out"
